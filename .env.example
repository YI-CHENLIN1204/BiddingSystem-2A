# Copy this file to .env and replace the placeholder with your PostgreSQL connection string.
DB_CONNECTION_STRING="Host=<host>;Port=5432;Database=<database>;Username=<username>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Command Timeout=60;Timeout=60;"

# Optional: 1D API base URL. Leave blank until 1D deployment URL/port is confirmed.
# Example: ONE_D_API_BASE_URL="http://host.docker.internal:8080/"
ONE_D_API_BASE_URL=""
