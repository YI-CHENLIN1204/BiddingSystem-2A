@{
    ViewData["Title"] = "建案管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="mb-3">
        <h3 class="mb-1">建案管理</h3>
        <div class="text-muted">
            查詢與管理歷史決標建案
        </div>
    </div>
</div>


<div class="card p-3 mb-3">
    <input id="projectSearch"
           class="form-control"
           placeholder="搜尋建案名稱或縣市" />
</div>


<div id="projectList"></div>


<div class="modal fade"
     id="projectModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="projectModalTitle">
                    建立建案
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="editingProjectId" />

                <div class="mb-3">
                    <label class="form-label">
                        建案名稱
                    </label>

                    <input id="projectName"
                           class="form-control" />
                </div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">
                            建案類型
                        </label>

                        <select id="projectType"
                                class="form-select">
                            <option value="">請選擇</option>
                            <option value="住宅">住宅</option>
                            <option value="廠房">廠房</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            結構類型
                        </label>

                        <select id="structureType"
                                class="form-select">
                            <option value="">請選擇</option>
                            <option value="RC">RC</option>
                            <option value="SC">SC</option>
                            <option value="SRC">SRC</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            縣市
                        </label>

                        <select id="city"
                                class="form-select">
                            <partial name="_CityOptions" />
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            總樓地板面積（m²）
                        </label>

                        <input id="totalFloorArea"
                               type="number"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            地上樓層數
                        </label>

                        <input id="floorCount"
                               type="number"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            地下樓層數
                        </label>

                        <input id="basementFloorCount"
                               type="number"
                               value="0"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            建案年月
                        </label>

                        <input id="projectMonth"
                               type="month"
                               class="form-control" />
                    </div>

                </div>
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    取消
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="saveProject()">
                    儲存
                </button>

            </div>
        </div>
    </div>
</div>


@section Scripts
{
<script>
    let projects = [];

    document.addEventListener(
        'DOMContentLoaded',
        async function () {

            await loadProjects();

            document
                .getElementById('projectSearch')
                .addEventListener(
                    'input',
                    debounce(
                        loadProjects,
                        300
                    )
                );
        }
    );


    async function loadProjects() {

        const search =
            document
                .getElementById('projectSearch')
                .value
                .trim();

        const response =
            await fetch(
                '/ProjectManagement/Projects?search=' +
                encodeURIComponent(search)
            );

        const data =
            await response.json();

        projects =
            data.items ?? [];

        renderProjects();
    }


    function renderProjects() {

        const container =
            document.getElementById(
                'projectList'
            );

        if (!projects.length) {

            container.innerHTML = `
                <div class="card p-4 text-muted">
                    目前沒有符合條件的建案
                </div>
            `;

            return;
        }

        container.innerHTML =
            projects.map(project => {

                const statusBadge =
                    project.hasFinalBid
                        ? `
                            <span class="badge bg-success">
                                已有決標資料
                            </span>
                        `
                        : `
                            <span class="badge bg-secondary">
                                尚無決標資料
                            </span>
                        `;

                const month =
                    project.startDate
                        ? project.startDate.substring(
                            0,
                            7
                        )
                        : '未設定';

                return `
                    <div class="card p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">

                                    <h5 class="mb-0">
                                        ${escapeHtml(project.projectName)}
                                    </h5>

                                    ${statusBadge}

                                </div>

                                <div class="text-muted small">
                                    ${escapeHtml(project.projectType ?? '未設定')}
                                    ｜
                                    ${escapeHtml(project.structureType ?? '未設定')}
                                    ｜
                                    ${escapeHtml(project.city ?? '未設定')}
                                    ｜
                                    ${month}
                                </div>
                            </div>

                            <div class="dropdown">

                                <button class="btn btn-sm btn-light border"
                                        data-bs-toggle="dropdown">
                                    ⋯
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item"
                                        href="/ProjectManagement/Detail?projectId=${project.projectId}">
                                            查看建案
                                        </a>
                                    </li>

                                    <li>
                                        <button class="dropdown-item"
                                                onclick="openEditProjectModal(${project.projectId})">
                                            修改基本資料
                                        </button>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>

                                    <li>
                                        <button class="dropdown-item text-danger"
                                                onclick="deleteProject(${project.projectId})">
                                            刪除建案
                                        </button>
                                    </li>

                                </ul>

                                </ul>
                            </div>
                        </div>

                        <hr />

                        <div class="row g-3 small">

                            <div class="col-md-3">
                                <div class="text-muted">
                                    總樓地板面積
                                </div>

                                <strong>
                                    ${project.totalFloorArea ?? '未設定'} m²
                                </strong>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted">
                                    地上 / 地下樓層
                                </div>

                                <strong>
                                    ${project.floorCount ?? '-'}
                                    /
                                    ${project.basementFloorCount ?? '-'}
                                </strong>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted">
                                    決標工項
                                </div>

                                <strong>
                                    ${project.finalBidItemCount}
                                </strong>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted">
                                    有效歷史交易
                                </div>

                                <strong>
                                    ${project.historicalTransactionCount}
                                </strong>
                            </div>

                        </div>

                    </div>
                `;
            })
            .join('');
    }



    function openEditProjectModal(
        projectId) {

        const project =
            projects.find(x =>
                Number(x.projectId) ===
                Number(projectId)
            );

        if (!project) {
            return;
        }

        document.getElementById(
            'projectModalTitle'
        ).textContent =
            '修改建案資料';

        document.getElementById(
            'editingProjectId'
        ).value =
            project.projectId;

        document.getElementById(
            'projectName'
        ).value =
            project.projectName ?? '';

        document.getElementById(
            'projectType'
        ).value =
            project.projectType ?? '';

        document.getElementById(
            'structureType'
        ).value =
            project.structureType ?? '';

        document.getElementById(
            'city'
        ).value =
            project.city ?? '';

        document.getElementById(
            'totalFloorArea'
        ).value =
            project.totalFloorArea ?? '';

        document.getElementById(
            'floorCount'
        ).value =
            project.floorCount ?? '';

        document.getElementById(
            'basementFloorCount'
        ).value =
            project.basementFloorCount ?? 0;

        document.getElementById(
            'projectMonth'
        ).value =
            project.startDate
                ? project.startDate.substring(
                    0,
                    7
                )
                : '';

        bootstrap.Modal
            .getOrCreateInstance(
                document.getElementById(
                    'projectModal'
                )
            )
            .show();
    }


    async function saveProject() {

        const projectId =
            document.getElementById(
                'editingProjectId'
            ).value;

        const request = {

            projectName:
                document.getElementById(
                    'projectName'
                ).value,

            projectType:
                document.getElementById(
                    'projectType'
                ).value,

            structureType:
                document.getElementById(
                    'structureType'
                ).value,

            city:
                document.getElementById(
                    'city'
                ).value,

            totalFloorArea:
                document.getElementById(
                    'totalFloorArea'
                ).value
                ? Number(
                    document.getElementById(
                        'totalFloorArea'
                    ).value
                )
                : null,

            floorCount:
                document.getElementById(
                    'floorCount'
                ).value
                ? Number(
                    document.getElementById(
                        'floorCount'
                    ).value
                )
                : null,

            basementFloorCount:
                document.getElementById(
                    'basementFloorCount'
                ).value !== ''
                ? Number(
                    document.getElementById(
                        'basementFloorCount'
                    ).value
                )
                : null,

            projectMonth:
                document.getElementById(
                    'projectMonth'
                ).value
        };

        if (!projectId) {
            alert('找不到要修改的建案');
            return;
        }

        const url =
            `/ProjectManagement/Update?projectId=${projectId}`;

        const response =
            await fetch(
                url,
                {
                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body:
                        JSON.stringify(request)
                }
            );

        const data =
            await response.json();

        if (!response.ok) {

            alert(
                data.message ??
                '建案儲存失敗'
            );

            return;
        }

        bootstrap.Modal
            .getInstance(
                document.getElementById(
                    'projectModal'
                )
            )
            ?.hide();

        await loadProjects();
    }


    async function deleteProject(
        projectId) {

        const project =
            projects.find(x =>
                Number(x.projectId) ===
                Number(projectId)
            );

        if (!project) {
            return;
        }

        const confirmed =
            confirm(
                `確定要刪除建案「${project.projectName}」嗎？\n\n` +
                `建案會被標記為已刪除，相關歷史交易也會停用。`
            );

        if (!confirmed) {
            return;
        }

        const response =
            await fetch(
                `/ProjectManagement/Delete?projectId=${projectId}`,
                {
                    method: 'POST'
                }
            );

        const data =
            await response.json();

        if (!response.ok) {

            alert(
                data.message ??
                '刪除失敗'
            );

            return;
        }

        await loadProjects();
    }


    function escapeHtml(value) {

        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }


    function debounce(
        func,
        delay) {

        let timer;

        return function () {

            clearTimeout(timer);

            timer =
                setTimeout(
                    func,
                    delay
                );
        };
    }
</script>
}