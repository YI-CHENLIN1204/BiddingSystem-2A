@model 崴正.Models.AuditLogPageViewModel

@{
    ViewData["Title"] = "操作紀錄";

    int startPage =
        Math.Max(
            1,
            Model.Page - 2
        );

    int endPage =
        Math.Min(
            Model.TotalPages,
            Model.Page + 2
        );

    var actionLabels =
        new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase)
        {
            ["Test"] = "測試",
            ["UpdateMapping"] = "更新材料對應",
            ["UpdateBidItem"] = "修改決標工項",
            ["IgnoreBidItem"] = "忽略決標工項",
            ["UnignoreBidItem"] = "取消忽略決標工項",

            ["CreateMaterial"] = "新增標準材料",
            ["UpdateMaterial"] = "修改標準材料",
            ["DisableMaterial"] = "停用標準材料",
            ["EnableMaterial"] = "啟用標準材料",

            ["CreateCategory"] = "新增材料分類",
            ["UpdateCategory"] = "修改材料分類",
            ["DisableCategory"] = "停用材料分類",
            ["EnableCategory"] = "啟用材料分類",

            ["CreateUnitCategory"] = "新增單位類別",
            ["CreateUnit"] = "新增單位",
            ["UpdateUnit"] = "修改單位",
            ["DisableUnit"] = "停用單位",
            ["EnableUnit"] = "啟用單位",

            ["UpdateEstimationSettings"] = "修改估算參數",
            ["EnableCoreMaterial"] = "設為核心材料",
            ["DisableCoreMaterial"] = "取消核心材料",

            ["UpdateProject"] = "修改建案",
            ["DeleteProject"] = "刪除建案",

            ["ImportFinalBid"] = "決標標單回寫",
            ["AnalyzeBidRange"] = "執行異常偵測"
        };

    var entityLabels =
        new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase)
        {
            ["System"] = "系統",
            ["FinalBidItem"] = "決標工項",
            ["MaterialMaster"] = "標準材料",
            ["MaterialCategory"] = "材料分類",
            ["UnitMaster"] = "標準單位",
            ["UnitCategory"] = "單位類別",
            ["EstimationSetting"] = "估算參數",
            ["QuantityRuleBase"] = "核心材料設定",
            ["ProjectMaster"] = "建案",
            ["BidRangeAnomalyAnalysis"] = "異常偵測分析"
        };

    string ActionLabel(
        string actionType)
    {
        return actionLabels.TryGetValue(
                actionType,
                out var label)
            ? label
            : actionType;
    }

    string EntityLabel(
        string entityType)
    {
        return entityLabels.TryGetValue(
                entityType,
                out var label)
            ? label
            : entityType;
    }
}

<style>
    .audit-page {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .audit-title-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
    }

    .audit-title {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
    }

    .audit-subtitle {
        margin-top: 4px;
        color: #6c757d;
        font-size: 14px;
    }

    .audit-count {
        color: #6c757d;
        font-size: 14px;
        white-space: nowrap;
    }

    .audit-filter-card {
        background: #ffffff;
        border: 1px solid var(--wz-border);
        border-radius: 6px;
        padding: 18px;
    }

    .audit-filter-grid {
        display: grid;
        grid-template-columns:
            minmax(240px, 2fr)
            repeat(2, minmax(170px, 1fr))
            repeat(2, minmax(150px, .9fr))
            auto;
        gap: 12px;
        align-items: end;
    }

    .audit-filter-item label {
        display: block;
        margin-bottom: 6px;
        color: #5b6573;
        font-size: 13px;
        font-weight: 700;
    }

    .audit-filter-actions {
        display: flex;
        gap: 8px;
    }

    .audit-table-card {
        background: #ffffff;
        border: 1px solid var(--wz-border);
        border-radius: 6px;
        overflow: hidden;
    }

    .audit-table-wrap {
        overflow-x: auto;
    }

    .audit-table {
        min-width: 980px;
        margin: 0;
    }

    .audit-table thead th {
        padding: 12px 14px;
        background: #f7f8fa;
        border-bottom: 1px solid var(--wz-border);
        color: #4f5965;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .audit-table tbody td {
        padding: 12px 14px;
        vertical-align: middle;
        border-color: #eef0f2;
        font-size: 14px;
    }

    .audit-module {
        font-weight: 700;
    }

    .audit-action {
        display: inline-block;
        padding: 4px 8px;
        border: 1px solid #d9dce1;
        border-radius: 999px;
        background: #f8f9fa;
        color: #45505d;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .audit-description {
        min-width: 280px;
        max-width: 460px;
    }

    .audit-project {
        min-width: 150px;
    }

    .audit-project-id {
        margin-top: 2px;
        color: #8a949e;
        font-size: 12px;
    }

    .audit-empty {
        padding: 48px 20px !important;
        text-align: center;
        color: #7b8490;
    }

    .audit-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-top: 1px solid var(--wz-border);
        background: #ffffff;
    }

    .audit-page-info {
        color: #6c757d;
        font-size: 13px;
    }

    .audit-detail-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .audit-meta-item {
        padding: 10px 12px;
        border: 1px solid #e8eaed;
        border-radius: 6px;
        background: #fbfbfc;
    }

    .audit-meta-label {
        margin-bottom: 3px;
        color: #7b8490;
        font-size: 12px;
    }

    .audit-meta-value {
        color: #27313c;
        font-size: 14px;
        font-weight: 700;
        word-break: break-word;
    }

    .audit-change-box {
        border: 1px solid #e2e5e9;
        border-radius: 6px;
        overflow: hidden;
        background: #ffffff;
    }

    .audit-change-empty {
        padding: 18px;
        color: #7b8490;
        text-align: center;
    }

    .audit-change-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .audit-change-table th,
    .audit-change-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #edf0f2;
        vertical-align: top;
        text-align: left;
        font-size: 13px;
    }

    .audit-change-table tr:last-child th,
    .audit-change-table tr:last-child td {
        border-bottom: 0;
    }

    .audit-change-table th {
        width: 38%;
        background: #f8f9fa;
        color: #56606c;
        font-weight: 700;
    }

    .audit-change-table td {
        color: #27313c;
        word-break: break-word;
    }

    .audit-change-section-title {
        margin-bottom: 8px;
        font-weight: 800;
    }

    @@media (max-width: 1200px) {
        .audit-filter-grid {
            grid-template-columns:
                repeat(2, minmax(180px, 1fr));
        }
    }
</style>

<div class="audit-page">
    <div class="audit-title-row">
        <div>
            <h1 class="audit-title">操作紀錄</h1>
            <div class="audit-subtitle">
                查詢系統內各項資料異動與分析操作紀錄
            </div>
        </div>

        <div class="audit-count">
            共 @Model.TotalCount 筆
        </div>
    </div>


    <form method="get"
          asp-controller="AuditLog"
          asp-action="Index"
          class="audit-filter-card">

        <div class="audit-filter-grid">
            <div class="audit-filter-item">
                <label for="search">關鍵字</label>
                <input id="search"
                       name="search"
                       class="form-control"
                       value="@Model.Search"
                       placeholder="說明、模組、操作、Entity ID..." />
            </div>


            <div class="audit-filter-item">
                <label for="module">模組</label>
                <select id="module"
                        name="module"
                        class="form-select">
                    <option value="">全部模組</option>

                    @foreach (var item in Model.Modules)
                    {
                        <option value="@item"
                                selected="@(Model.Module == item)">
                            @item
                        </option>
                    }
                </select>
            </div>


            <div class="audit-filter-item">
                <label for="actionType">操作類型</label>
                <select id="actionType"
                        name="actionType"
                        class="form-select">
                    <option value="">全部操作</option>

                    @foreach (var item in Model.ActionTypes)
                    {
                        <option value="@item"
                                selected="@(Model.ActionType == item)">
                            @ActionLabel(item)
                        </option>
                    }
                </select>
            </div>


            <div class="audit-filter-item">
                <label for="startDate">開始日期</label>
                <input id="startDate"
                       name="startDate"
                       type="date"
                       class="form-control"
                       value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>


            <div class="audit-filter-item">
                <label for="endDate">結束日期</label>
                <input id="endDate"
                       name="endDate"
                       type="date"
                       class="form-control"
                       value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>


            <div class="audit-filter-actions">
                <button type="submit"
                        class="btn btn-primary">
                    查詢
                </button>

                <a asp-controller="AuditLog"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    清除
                </a>
            </div>
        </div>


        <input type="hidden"
               name="pageSize"
               value="@Model.PageSize" />
    </form>


    <div class="audit-table-card">
        <div class="audit-table-wrap">
            <table class="table audit-table">
                <thead>
                    <tr>
                        <th>時間</th>
                        <th>模組</th>
                        <th>操作</th>
                        <th>說明</th>
                        <th>建案</th>
                        <th>詳細</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6"
                                class="audit-empty">
                                沒有符合條件的操作紀錄
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="audit-time"
                                          data-utc="@item.CreatedAt.ToUniversalTime().ToString("O")">
                                        @item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                    </span>
                                </td>

                                <td>
                                    <span class="audit-module">
                                        @item.Module
                                    </span>
                                </td>

                                <td>
                                    <span class="audit-action"
                                          title="@item.ActionType">
                                        @ActionLabel(item.ActionType)
                                    </span>
                                </td>

                                <td class="audit-description">
                                    @item.Description
                                </td>

                                <td class="audit-project">
                                    @if (!string.IsNullOrWhiteSpace(
                                            item.ProjectName))
                                    {
                                        <div>@item.ProjectName</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">—</div>
                                    }

                                    @if (item.ProjectId.HasValue)
                                    {
                                        <div class="audit-project-id">
                                            Project ID：@item.ProjectId
                                        </div>
                                    }
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary audit-detail-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#auditDetailModal"
                                            data-log-id="@item.LogId"
                                            data-module="@item.Module"
                                            data-action="@ActionLabel(item.ActionType)"
                                            data-entity-type="@EntityLabel(item.EntityType)"
                                            data-entity-id="@item.EntityId"
                                            data-description="@item.Description">
                                        查看
                                    </button>

                                    <textarea id="audit-old-@item.LogId"
                                              hidden>@item.OldValue</textarea>

                                    <textarea id="audit-new-@item.LogId"
                                              hidden>@item.NewValue</textarea>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>


        <div class="audit-footer">
            <div class="audit-page-info">
                第 @Model.Page / @Model.TotalPages 頁
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Audit log pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="AuditLog"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-module="@Model.Module"
                               asp-route-actionType="@Model.ActionType"
                               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize">
                                上一頁
                            </a>
                        </li>

                        @for (int pageNumber = startPage;
                            pageNumber <= endPage;
                            pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="AuditLog"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-module="@Model.Module"
                                   asp-route-actionType="@Model.ActionType"
                                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-page="@pageNumber"
                                   asp-route-pageSize="@Model.PageSize">
                                    @pageNumber
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="AuditLog"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-module="@Model.Module"
                               asp-route-actionType="@Model.ActionType"
                               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize">
                                下一頁
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>


<div class="modal fade"
     id="auditDetailModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">
                        操作紀錄詳細內容
                    </h5>

                    <div class="text-muted small"
                         id="auditDetailId">
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <div class="audit-detail-meta">
                    <div class="audit-meta-item">
                        <div class="audit-meta-label">模組</div>
                        <div class="audit-meta-value"
                             id="auditDetailModule">
                        </div>
                    </div>

                    <div class="audit-meta-item">
                        <div class="audit-meta-label">操作</div>
                        <div class="audit-meta-value"
                             id="auditDetailAction">
                        </div>
                    </div>

                    <div class="audit-meta-item">
                        <div class="audit-meta-label">資料類型</div>
                        <div class="audit-meta-value"
                             id="auditDetailEntity">
                        </div>
                    </div>

                    <div class="audit-meta-item">
                        <div class="audit-meta-label">資料編號</div>
                        <div class="audit-meta-value"
                             id="auditDetailEntityId">
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="fw-bold mb-2">操作說明</div>
                    <div id="auditDetailDescription"></div>
                </div>

                <div class="mb-4">
                    <div class="audit-change-section-title">
                        修改前
                    </div>

                    <div class="audit-change-box"
                         id="auditDetailOld">
                    </div>
                </div>

                <div>
                    <div class="audit-change-section-title">
                        修改後
                    </div>

                    <div class="audit-change-box"
                         id="auditDetailNew">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (() => {
            const fieldLabels = {
                materialId: "材料編號",
                materialName: "材料名稱",
                mappingStatus: "對應狀態",

                itemName: "工項名稱",
                qty: "數量",
                unitPrice: "單價",
                unit: "標單單位",
                dataIssueCode: "資料問題代碼",
                dataIssueMessage: "資料問題說明",
                historyAction: "歷史交易處理",

                categoryId: "分類編號",
                categoryName: "分類名稱",

                unitId: "單位編號",
                unitName: "單位名稱",
                unitCategoryId: "單位類別編號",
                allowConversion: "允許換算",
                toBaseFactor: "換算倍率",
                isBaseUnit: "是否基準單位",

                isActive: "啟用狀態",
                isIgnored: "忽略狀態",
                historyDeleted: "歷史交易已刪除",

                projectId: "建案編號",
                projectName: "建案名稱",
                projectType: "建案類型",
                structureType: "結構類型",
                city: "縣市",
                totalFloorArea: "總樓地板面積",
                floorCount: "地上樓層",
                basementFloorCount: "地下樓層",
                projectMonth: "建案年月",
                projectDate: "建案日期",
                floorRange: "樓層範圍",
                isDeleted: "刪除狀態",
                activeHistoricalTransactionCount: "有效歷史交易數",
                deletedHistoricalTransactionCount: "停用歷史交易數",

                sourceFileName: "來源檔案",
                fileName: "檔案名稱",
                totalCount: "工項總數",
                autoMappedCount: "自動對應數",
                unmappedCount: "未對應數",
                historyInsertCount: "新增歷史交易數",
                invalidQuantityCount: "無效數量數",
                invalidUnitPriceCount: "無效單價數",
                unitMismatchCount: "單位不符數",

                parsedRowCount: "解析列數",
                mappedRowCount: "成功對應列數",
                unmappedRowCount: "未對應列數",
                invalidRowCount: "無效列數",
                materialCount: "材料數",
                candidateProjectCount: "候選建案數",
                lowCount: "偏低數",
                highCount: "偏高數",
                normalCount: "正常數",
                insufficientSampleCount: "樣本不足數",

                topK: "Top K",
                minimumSampleCount: "最低樣本數",
                lowerQuantile: "下界分位數",
                medianQuantile: "中位分位數",
                upperQuantile: "上界分位數",
                similarityExponent: "相似度指數",
                timeHalfLifeYears: "時間半衰期（年）",
                minimumSimilarityScore: "最低相似度",
                structureWeight: "結構權重",
                areaWeight: "面積權重",
                floorWeight: "樓層權重",
                yearWeight: "年份權重",
                cityWeight: "縣市權重",
                areaDifferenceCutoffRatio: "面積差距截止比例",
                groundFloorPenaltyRatio: "地上樓層懲罰比例",
                basementFloorPenaltyRatio: "地下樓層懲罰比例",
                yearDifferenceCutoffYears: "年份差距截止值",
                isCoreEstimation: "核心材料"
            };


            function labelFor(key) {
                if (fieldLabels[key]) {
                    return fieldLabels[key];
                }

                return key
                    .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
                    .replace(/_/g, " ");
            }


            function displayScalar(value) {
                if (value === null ||
                    value === undefined ||
                    value === "") {
                    return "—";
                }

                if (typeof value === "boolean") {
                    return value
                        ? "是"
                        : "否";
                }

                return String(value);
            }


            function displayValue(value) {
                if (Array.isArray(value)) {
                    if (value.length === 0) {
                        return "—";
                    }

                    return value
                        .map(item => {
                            if (
                                item !== null &&
                                typeof item === "object"
                            ) {
                                return Object.entries(item)
                                    .map(([key, itemValue]) =>
                                        `${labelFor(key)}：${displayScalar(itemValue)}`
                                    )
                                    .join("、");
                            }

                            return displayScalar(item);
                        })
                        .join("；");
                }

                if (
                    value !== null &&
                    typeof value === "object"
                ) {
                    return Object.entries(value)
                        .map(([key, itemValue]) =>
                            `${labelFor(key)}：${displayScalar(itemValue)}`
                        )
                        .join("、");
                }

                return displayScalar(value);
            }


            function renderChange(container, rawValue) {
                container.innerHTML = "";

                if (!rawValue ||
                    !rawValue.trim()) {
                    const empty =
                        document.createElement("div");

                    empty.className =
                        "audit-change-empty";

                    empty.textContent =
                        "無資料";

                    container.appendChild(
                        empty
                    );

                    return;
                }


                let parsed;

                try {
                    parsed =
                        JSON.parse(
                            rawValue
                        );
                } catch {
                    const simple =
                        document.createElement("div");

                    simple.className =
                        "audit-change-empty";

                    simple.textContent =
                        rawValue;

                    container.appendChild(
                        simple
                    );

                    return;
                }


                if (
                    parsed === null ||
                    typeof parsed !== "object" ||
                    Array.isArray(parsed)
                ) {
                    const simple =
                        document.createElement("div");

                    simple.className =
                        "audit-change-empty";

                    simple.textContent =
                        displayValue(parsed);

                    container.appendChild(
                        simple
                    );

                    return;
                }


                const entries =
                    Object.entries(parsed);

                if (entries.length === 0) {
                    const empty =
                        document.createElement("div");

                    empty.className =
                        "audit-change-empty";

                    empty.textContent =
                        "無資料";

                    container.appendChild(
                        empty
                    );

                    return;
                }


                const table =
                    document.createElement("table");

                table.className =
                    "audit-change-table";


                const tbody =
                    document.createElement("tbody");


                entries.forEach(
                    ([key, value]) => {
                        const row =
                            document.createElement("tr");

                        const labelCell =
                            document.createElement("th");

                        const valueCell =
                            document.createElement("td");


                        labelCell.textContent =
                            labelFor(key);

                        valueCell.textContent =
                            displayValue(value);


                        row.appendChild(
                            labelCell
                        );

                        row.appendChild(
                            valueCell
                        );

                        tbody.appendChild(
                            row
                        );
                    }
                );


                table.appendChild(
                    tbody
                );

                container.appendChild(
                    table
                );
            }


            document
                .querySelectorAll(".audit-time")
                .forEach(element => {
                    const utc =
                        element.dataset.utc;

                    if (!utc) {
                        return;
                    }

                    const date =
                        new Date(utc);

                    if (Number.isNaN(
                            date.getTime())) {
                        return;
                    }

                    element.textContent =
                        date.toLocaleString(
                            "zh-TW",
                            {
                                year: "numeric",
                                month: "2-digit",
                                day: "2-digit",
                                hour: "2-digit",
                                minute: "2-digit",
                                second: "2-digit",
                                hour12: false
                            }
                        );
                });


            document
                .querySelectorAll(
                    ".audit-detail-button"
                )
                .forEach(button => {
                    button.addEventListener(
                        "click",
                        () => {
                            const logId =
                                button.dataset.logId;

                            const oldValue =
                                document.getElementById(
                                    `audit-old-${logId}`
                                )?.value ?? "";

                            const newValue =
                                document.getElementById(
                                    `audit-new-${logId}`
                                )?.value ?? "";


                            document.getElementById(
                                "auditDetailId"
                            ).textContent =
                                `Log ID：${logId}`;


                            document.getElementById(
                                "auditDetailModule"
                            ).textContent =
                                button.dataset.module
                                || "—";


                            document.getElementById(
                                "auditDetailAction"
                            ).textContent =
                                button.dataset.action
                                || "—";


                            document.getElementById(
                                "auditDetailEntity"
                            ).textContent =
                                button.dataset.entityType
                                || "—";


                            document.getElementById(
                                "auditDetailEntityId"
                            ).textContent =
                                button.dataset.entityId
                                || "—";


                            document.getElementById(
                                "auditDetailDescription"
                            ).textContent =
                                button.dataset.description
                                || "—";


                            renderChange(
                                document.getElementById(
                                    "auditDetailOld"
                                ),
                                oldValue
                            );


                            renderChange(
                                document.getElementById(
                                    "auditDetailNew"
                                ),
                                newValue
                            );
                        }
                    );
                });
        })();
    </script>
}
