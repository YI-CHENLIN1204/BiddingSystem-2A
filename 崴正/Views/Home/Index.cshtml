@{
    ViewData["Title"] = "標單異常偵測";
}

<style>
    :root {
        --wz-primary: #321fdb;
        --wz-bg: #f3f5f7;
        --wz-card: #ffffff;
        --wz-border: #d8dbe0;
        --wz-text: #1f2d3d;
        --wz-muted: #6c757d;
        --wz-green: #198754;
        --wz-red: #dc3545;
        --wz-orange: #b58100;
        --wz-table-head: #5b6065;
    }

    body {
        background: var(--wz-bg);
    }

    .anomaly-page {
        max-width: 96vw;
        margin: 0 auto;
        padding: 20px 0 40px;
    }

    .page-title {
        font-size: 1.55rem;
        font-weight: 800;
        color: var(--wz-text);
        margin-bottom: 5px;
    }

    .page-desc {
        font-size: 14px;
        color: var(--wz-muted);
        margin-bottom: 18px;
    }

    .anomaly-card {
        background: var(--wz-card);
        border: 1px solid var(--wz-border);
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(20, 29, 35, .06);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .card-header-wz {
        padding: 13px 17px;
        background: #f8f9fa;
        border-bottom: 1px solid var(--wz-border);
    }

    .card-title-wz {
        font-size: 15px;
        font-weight: 800;
        color: var(--wz-primary);
        margin: 0;
    }

    .card-desc-wz {
        margin-top: 3px;
        color: var(--wz-muted);
        font-size: 12px;
    }

    .card-body-wz {
        padding: 18px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 700;
        color: #333;
    }

    .form-control,
    .form-select {
        border-radius: 6px;
        border: 1px solid var(--wz-border);
        font-size: 14px;
    }

    .file-area {
        display: flex;
        align-items: stretch;
        gap: 12px;
    }

    .file-input-native {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .file-picker {
        flex: 1;
        height: 44px;
        border: 1px solid var(--wz-border);
        border-radius: 6px;
        display: flex;
        align-items: center;
        background: white;
        overflow: hidden;
        cursor: pointer;
    }

    .file-picker:hover {
        border-color: var(--wz-primary);
    }

    .file-picker-button {
        height: 100%;
        padding: 0 18px;
        display: flex;
        align-items: center;
        background: #f0f2ff;
        color: var(--wz-primary);
        border-right: 1px solid var(--wz-border);
        font-weight: 700;
        white-space: nowrap;
    }

    .file-picker-name {
        padding: 0 14px;
        color: var(--wz-muted);
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-picker-name.has-file {
        color: var(--wz-text);
        font-weight: 600;
    }

    .action-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        align-items: center;
    }

    .btn-analyze {
        border: none;
        background: var(--wz-primary);
        color: white;
        border-radius: 6px;
        padding: 9px 22px;
        font-weight: 700;
    }

    .btn-analyze:hover {
        color: white;
        filter: brightness(.96);
    }

    .btn-analyze:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .message-box {
        display: none;
        padding: 11px 14px;
        margin-bottom: 14px;
        border-radius: 6px;
        font-size: 13px;
    }

    .message-box.error {
        display: block;
        color: #842029;
        background: #f8d7da;
        border: 1px solid #f5c2c7;
    }

    .message-box.info {
        display: block;
        color: #055160;
        background: #cff4fc;
        border: 1px solid #b6effb;
    }

    .result-wrapper {
        overflow-x: auto;
        border: 1px solid var(--wz-border);
        border-radius: 7px;
    }

    .result-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
        margin: 0;
        background: white;
        font-size: 13px;
    }

    .result-table th {
        padding: 10px 8px;
        text-align: center;
        color: white;
        background: var(--wz-table-head);
        white-space: nowrap;
        font-weight: 700;
    }

    .result-table td {
        padding: 10px 8px;
        border-bottom: 1px solid #e5e7eb;
        text-align: center;
        vertical-align: middle;
    }

    .result-table tbody tr:hover {
        background: #fafafa;
    }

    .material-cell {
        text-align: left !important;
        font-weight: 700;
    }

    .number-cell {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-high {
        color: #842029;
        background: #f8d7da;
    }

    .status-low {
        color: #664d03;
        background: #fff3cd;
    }

    .status-normal {
        color: #0f5132;
        background: #d1e7dd;
    }

    .status-insufficient {
        color: #495057;
        background: #e9ecef;
    }

    .section-title {
        font-weight: 800;
        font-size: 15px;
        margin-bottom: 10px;
    }

    .result-note {
        color: var(--wz-muted);
        font-size: 12px;
        margin-bottom: 12px;
    }

    .loading-box {
        display: none;
        text-align: center;
        padding: 18px;
        color: var(--wz-muted);
        font-size: 14px;
    }

    .loading-box.show {
        display: block;
    }

    .empty-row {
        text-align: center !important;
        color: var(--wz-muted);
        padding: 24px !important;
    }

    #resultSection,
    #problemSection {
        display: none;
    }

    @@media (max-width: 1200px) {
        .summary-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .file-area {
            flex-direction: column;
        }

        .action-row {
            justify-content: stretch;
        }

        .btn-analyze {
            width: 100%;
        }
    }

    .result-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
}

    .result-toolbar-text {
        flex: 1;
    }

    @@media (max-width: 768px) 
    {
        .result-toolbar 
        {
            flex-direction: column;
            align-items: stretch;
        }

        .result-toolbar-search {
            width: 100%;
        }
    }
    .result-toolbar-search {
        width: 430px;
        max-width: 100%;
        min-width: 0;
    }

    .anomaly-filter-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 140px;
        gap: 10px;
        width: 100%;
        min-width: 0;
    }

    .anomaly-filter-row .form-control,
    .anomaly-filter-row .form-select {
        width: 100%;
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .anomaly-filter-row {
            width: 100%;
            grid-template-columns: 1fr;
        }
    }
    .problem-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }
</style>


<div class="anomaly-page">

    <h2 class="page-title">
        標單異常偵測
    </h2>

    <div class="page-desc">
        輸入目標建案條件並上傳待檢標單，系統將依相似歷史建案建立材料合理用量區間，
        再與標單實際用量進行比較。
    </div>


    <div class="anomaly-card">

        <div class="card-header-wz">
            <div class="card-title-wz">
                1. 目標建案條件
            </div>

            <div class="card-desc-wz">
                建案條件只供本次分析使用，不會建立新的歷史建案資料。
            </div>
        </div>


        <div class="card-body-wz">

            <div class="row g-3">

                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        建案類型
                    </label>

                    <select id="projectType"
                            class="form-select">
                        <option value="">請選擇</option>
                        <option value="住宅">住宅</option>
                        <option value="廠房">廠房</option>
                    </select>
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        結構類型
                    </label>

                    <select id="structureType"
                            class="form-select">
                        <option value="">請選擇</option>
                        <option value="RC">RC</option>
                        <option value="SC">SC</option>
                        <option value="SRC">SRC</option>
                    </select>
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        縣市
                    </label>

                    <select id="city"
                            class="form-select">
                        @await Html.PartialAsync("_CityOptions")
                    </select>
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        總樓地板面積
                    </label>

                    <div class="input-group">
                        <input id="totalFloorArea"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="例如 18000" />

                        <span class="input-group-text">
                            m²
                        </span>
                    </div>
                </div>


                <div class="col-lg-1 col-md-4">
                    <label class="form-label">
                        地上樓層
                    </label>

                    <input id="floorCount"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="20" />
                </div>


                <div class="col-lg-1 col-md-4">
                    <label class="form-label">
                        地下樓層
                    </label>

                    <input id="basementFloorCount"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="3" />
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        建案年月
                    </label>

                    <input id="projectMonth"
                           type="month"
                           class="form-control" />
                </div>

            </div>

        </div>
    </div>


    <div class="anomaly-card">

        <div class="card-header-wz">
            <div class="card-title-wz">
                2. 上傳待檢標單
            </div>

            <div class="card-desc-wz">
                支援 .xlsx、.xls、.xlsm、.xlsb、.csv 格式；上傳檔案只供本次分析，不會寫入歷史資料。
            </div>
        </div>


        <div class="card-body-wz">

            <div class="file-area">

                <input type="file"
                       id="excelFile"
                       class="file-input-native"
                       accept=".xlsx,.xls,.xlsm,.xlsb,.csv"/>

                <label for="excelFile"
                       class="file-picker">

                    <span class="file-picker-button">
                        選擇 Excel 檔案
                    </span>

                    <span id="excelFileName"
                          class="file-picker-name">
                        尚未選擇檔案
                    </span>

                </label>

            </div>

        </div>
    </div>


    <div class="anomaly-card">

        <div class="card-body-wz">

            <div id="messageBox"
                 class="message-box">
            </div>


            <div class="action-row">

                <button type="button"
                        class="btn btn-outline-secondary"
                        id="clearButton">
                    清除
                </button>


                <button type="button"
                        class="btn-analyze"
                        id="analyzeButton">
                    開始異常分析
                </button>

            </div>

        </div>

    </div>


    <div class="anomaly-card"
         id="resultSection">

        <div class="card-header-wz">
            <div class="card-title-wz">
                3. 分析結果
            </div>

            <div class="card-desc-wz"
                 id="resultFileName">
            </div>
        </div>


        <div class="card-body-wz">

            <div id="loadingBox"
                 class="loading-box">
                系統正在解析標單並計算合理用量區間，請稍候。
            </div>


            <div id="resultContent">


                <div class="result-toolbar">

                    <div class="result-toolbar-text">

                        <div class="section-title">
                            材料異常分析
                        </div>

                        <div class="result-note">
                            實際數量低於 P15 判定為偏低，高於 P85 判定為偏高；
                            歷史樣本不足時不進行異常判定。
                        </div>

                    </div>


                    <div class="result-toolbar-search">

                        <div class="anomaly-filter-row">

                            <input type="search"
                                id="anomalySearch"
                                class="form-control"
                                placeholder="搜尋材料名稱" />


                            <select id="anomalyStatusFilter"
                                    class="form-select">

                                <option value="">
                                    全部判定
                                </option>

                                <option value="High">
                                    偏高
                                </option>

                                <option value="Low">
                                    偏低
                                </option>

                                <option value="Normal">
                                    正常
                                </option>

                                <option value="InsufficientSamples">
                                    樣本不足
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <div class="result-wrapper">

                    <table class="result-table">

                        <thead>
                            <tr>
                                <th>材料</th>
                                <th>實際數量</th>
                                <th>P15 下界</th>
                                <th>P50 中位</th>
                                <th>P85 上界</th>
                                <th>單位</th>
                                <th>來源工項</th>
                                <th>參考樣本</th>
                                <th>判定</th>
                                <th>說明</th>
                            </tr>
                        </thead>

                        <tbody id="resultBody">
                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    </div>


    <div class="anomaly-card"
         id="problemSection">

        <div class="card-header-wz problem-header">

            <div>

                <div class="card-title-wz">
                    4. 未對應與無效工項
                    <span id="problemCountText"></span>
                </div>

                <div class="card-desc-wz">
                    這些工項未進入材料合理區間比較，需要時再查看明細。
                </div>

            </div>


            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    id="toggleProblemButton"
                    onclick="toggleProblemDetail()">
                查看明細
            </button>

        </div>


        <div class="card-body-wz"id="problemDetail"style="display:none;">

            <div class="result-wrapper">

                <table class="result-table">

                    <thead>
                        <tr>
                            <th>工作表</th>
                            <th>列號</th>
                            <th>項目名稱</th>
                            <th>規格</th>
                            <th>原單位</th>
                            <th>原數量</th>
                            <th>原因</th>
                        </tr>
                    </thead>

                    <tbody id="problemBody">
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

<script>

    const excelFile =
        document.getElementById("excelFile");

    const excelFileName =
        document.getElementById("excelFileName");

    const analyzeButton =
        document.getElementById("analyzeButton");

    const clearButton =
        document.getElementById("clearButton");

    const messageBox =
        document.getElementById("messageBox");

    const resultSection =
        document.getElementById("resultSection");

    const problemSection =
        document.getElementById("problemSection");

    const resultBody =
        document.getElementById("resultBody");

    const problemBody =
        document.getElementById("problemBody");

    const loadingBox =
        document.getElementById("loadingBox");

    const resultContent =
        document.getElementById("resultContent");

    const problemDetail =
        document.getElementById("problemDetail");

    const toggleProblemButton =
        document.getElementById("toggleProblemButton");


    excelFile.addEventListener(
        "change",
        function () {

            const file =
                excelFile.files &&
                excelFile.files.length > 0
                    ? excelFile.files[0]
                    : null;


            excelFileName.textContent =
                file
                    ? file.name
                    : "尚未選擇檔案";


            excelFileName.classList.toggle(
                "has-file",
                Boolean(file)
            );

        }
    );


    analyzeButton.addEventListener(
        "click",
        async function () {

            hideMessage();


            try {

                const projectType =
                    document
                        .getElementById("projectType")
                        .value;

                const structureType =
                    document
                        .getElementById("structureType")
                        .value;

                const city =
                    document
                        .getElementById("city")
                        .value;

                const totalFloorArea =
                    Number(
                        document
                            .getElementById("totalFloorArea")
                            .value
                    );

                const floorCount =
                    Number(
                        document
                            .getElementById("floorCount")
                            .value
                    );

                const basementFloorCountValue =
                    document
                        .getElementById("basementFloorCount")
                        .value;

                const basementFloorCount =
                    basementFloorCountValue === ""
                        ? null
                        : Number(
                            basementFloorCountValue
                        );

                const projectMonth =
                    document
                        .getElementById("projectMonth")
                        .value;


                if (!projectType) {
                    throw new Error(
                        "請選擇建案類型"
                    );
                }

                if (!structureType) {
                    throw new Error(
                        "請選擇結構類型"
                    );
                }

                if (!city) {
                    throw new Error(
                        "請選擇縣市"
                    );
                }

                if (
                    !totalFloorArea ||
                    totalFloorArea <= 0
                ) {
                    throw new Error(
                        "請輸入有效的總樓地板面積"
                    );
                }

                if (
                    !floorCount ||
                    floorCount <= 0
                ) {
                    throw new Error(
                        "請輸入有效的地上樓層數"
                    );
                }

                if (
                    basementFloorCount === null ||
                    basementFloorCount < 0
                ) {
                    throw new Error(
                        "請輸入有效的地下樓層數"
                    );
                }

                if (!projectMonth) {
                    throw new Error(
                        "請選擇建案年月"
                    );
                }


                if (
                    !excelFile.files ||
                    excelFile.files.length === 0
                ) {
                    throw new Error(
                        "請選擇待檢 Excel 標單"
                    );
                }


                const file =
                    excelFile.files[0];

                const fileName =
                    file.name.toLowerCase();


                const allowedExtensions =
                [
                    '.xlsx',
                    '.xls',
                    '.xlsm',
                    '.xlsb',
                    '.csv'
                ];

                const lowerFileName =
                    file.name.toLowerCase();

                const isAllowed =
                    allowedExtensions.some(
                        extension =>
                            lowerFileName.endsWith(
                                extension
                            )
                    );

                if (!isAllowed) {

                    showMessage(
                        '支援格式：.xlsx、.xls、.xlsm、.xlsb、.csv'
                    );

                    return;
                }


                const formData =
                    new FormData();


                formData.append(
                    "excelFile",
                    file
                );

                formData.append(
                    "projectType",
                    projectType
                );

                formData.append(
                    "structureType",
                    structureType
                );

                formData.append(
                    "city",
                    city
                );

                formData.append(
                    "totalFloorArea",
                    totalFloorArea.toString()
                );

                formData.append(
                    "floorCount",
                    floorCount.toString()
                );

                formData.append(
                    "basementFloorCount",
                    basementFloorCount.toString()
                );

                formData.append(
                    "projectMonth",
                    projectMonth
                );


                analyzeButton.disabled =
                    true;

                analyzeButton.textContent =
                    "分析中";


                resultSection.style.display =
                    "block";

                problemSection.style.display =
                    "none";

                loadingBox.classList.add(
                    "show"
                );

                resultContent.style.display =
                    "none";


                const response =
                    await fetch(
                        "/api/bid-anomaly/analyze",
                        {
                            method: "POST",
                            body: formData
                        }
                    );


                const raw =
                    await response.text();


                let data = {};


                if (raw) {
                    try {
                        data =
                            JSON.parse(raw);
                    }
                    catch {
                        data = {};
                    }
                }


                if (!response.ok) {
                    throw new Error(
                        data.message ??
                        `異常分析失敗，HTTP ${response.status}`
                    );
                }


                renderResult(
                    data
                );

            }
            catch (error) {

                showMessage(
                    error.message ??
                    "異常分析失敗"
                );


                resultSection.style.display =
                    "none";

                problemSection.style.display =
                    "none";

            }
            finally {

                analyzeButton.disabled =
                    false;

                analyzeButton.textContent =
                    "開始異常分析";

                loadingBox.classList.remove(
                    "show"
                );

            }

        }
    );


    function renderResult(data) {

        anomalySearch.value =
            "";

        anomalyStatusFilter.value =
            "";

        problemDetail.style.display =
            "none";

        toggleProblemButton.textContent =
            "查看明細";


        const results =
            data.results ?? [];

        const problems =
            data.unmappedItems ?? [];

        document
            .getElementById(
                "problemCountText"
            )
            .textContent =
                problems.length > 0
                    ? `（${problems.length} 筆）`
                    : "";


        document
            .getElementById("resultFileName")
            .textContent =
                data.fileName
                    ? `檔案：${data.fileName}`
                    : "";

        resultBody.innerHTML =
            "";


        if (results.length === 0) {

            resultBody.innerHTML = `
                <tr>
                    <td colspan="10"
                        class="empty-row">
                        本次沒有可進行合理區間比較的材料
                    </td>
                </tr>
            `;

        }
        else {

            results.forEach(item => {

                const tr =
                    document.createElement(
                        "tr"
                    );

                tr.dataset.status =
                    item.anomalyStatus ?? "";


                tr.innerHTML = `

                    <td class="material-cell">
                        ${escapeHtml(
                            item.materialName ?? ""
                        )}
                    </td>

                    <td class="number-cell">
                        ${formatNumber(
                            item.actualQuantity
                        )}
                    </td>

                    <td class="number-cell">
                        ${formatNullableNumber(
                            item.lowerQuantity
                        )}
                    </td>

                    <td class="number-cell">
                        ${formatNullableNumber(
                            item.medianQuantity
                        )}
                    </td>

                    <td class="number-cell">
                        ${formatNullableNumber(
                            item.upperQuantity
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            item.baseUnit ?? ""
                        )}
                    </td>

                    <td>
                        ${item.sourceRowCount ?? 0}
                    </td>

                    <td>
                        ${item.referenceProjectCount ?? 0}
                        /
                        ${item.minimumSampleCount ?? 0}
                    </td>

                    <td>
                        ${renderStatus(
                            item.anomalyStatus
                        )}
                    </td>

                    <td class="material-cell">
                        ${escapeHtml(
                            item.statusMessage ?? ""
                        )}
                    </td>
                `;


                resultBody.appendChild(
                    tr
                );

            });

        }


        problemBody.innerHTML =
            "";


        if (problems.length > 0) {

            problems.forEach(item => {

                const tr =
                    document.createElement(
                        "tr"
                    );


                tr.innerHTML = `

                    <td>
                        ${escapeHtml(
                            item.sheetName ?? ""
                        )}
                    </td>

                    <td>
                        ${item.rowNumber ?? ""}
                    </td>

                    <td class="material-cell">
                        ${escapeHtml(
                            item.itemName ?? ""
                        )}
                    </td>

                    <td class="material-cell">
                        ${escapeHtml(
                            item.spec ?? ""
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            item.unit ?? ""
                        )}
                    </td>

                    <td class="number-cell">
                        ${formatNullableNumber(
                            item.quantity
                        )}
                    </td>

                    <td class="material-cell">
                        ${escapeHtml(
                            item.reason ?? ""
                        )}
                    </td>
                `;


                problemBody.appendChild(
                    tr
                );

            });


            problemSection.style.display =
                "block";

        }
        else {

            problemSection.style.display =
                "none";

        }


        resultContent.style.display =
            "block";


        resultSection.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });

    }


    function renderStatus(status) {

        switch (status) {

            case "High":
                return `
                    <span class="status-badge status-high">
                        偏高
                    </span>
                `;

            case "Low":
                return `
                    <span class="status-badge status-low">
                        偏低
                    </span>
                `;

            case "Normal":
                return `
                    <span class="status-badge status-normal">
                        正常
                    </span>
                `;

            case "InsufficientSamples":
                return `
                    <span class="status-badge status-insufficient">
                        樣本不足
                    </span>
                `;

            default:
                return `
                    <span class="status-badge status-insufficient">
                        無法判定
                    </span>
                `;
        }

    }


    clearButton.addEventListener(
        "click",
        function () {

            document
                .getElementById("projectType")
                .value = "";

            document
                .getElementById("structureType")
                .value = "";

            document
                .getElementById("city")
                .value = "";

            document
                .getElementById("totalFloorArea")
                .value = "";

            document
                .getElementById("floorCount")
                .value = "";

            document
                .getElementById("basementFloorCount")
                .value = "";

            document
                .getElementById("projectMonth")
                .value = "";


            excelFile.value =
                "";

            excelFileName.textContent =
                "尚未選擇檔案";

            excelFileName.classList.remove(
                "has-file"
            );

            anomalySearch.value =
            "";

            anomalyStatusFilter.value =
                "";

            problemDetail.style.display =
                "none";

            toggleProblemButton.textContent =
                "查看明細";


            resultSection.style.display =
                "none";

            problemSection.style.display =
                "none";

            hideMessage();

        }
    );


    function showMessage(message) {

        messageBox.className =
            "message-box error";

        messageBox.textContent =
            message;

    }


    function hideMessage() {

        messageBox.className =
            "message-box";

        messageBox.textContent =
            "";

    }


    function formatNumber(value) {

        const number =
            Number(value);


        if (!Number.isFinite(number)) {
            return "未提供";
        }


        return number.toLocaleString(
            "zh-TW",
            {
                maximumFractionDigits: 2
            }
        );

    }


    function formatNullableNumber(value) {

        if (
            value === null ||
            value === undefined
        ) {
            return "樣本不足";
        }


        return formatNumber(
            value
        );

    }


    function escapeHtml(value) {

        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    }

    const anomalySearch =
        document.getElementById(
            "anomalySearch"
        );

    const anomalyStatusFilter =
        document.getElementById(
            "anomalyStatusFilter"
        );


    anomalySearch.addEventListener(
        "input",
        filterAnomalyResults
    );

    anomalyStatusFilter.addEventListener(
        "change",
        filterAnomalyResults
    );


    function filterAnomalyResults() {

        const keyword =
            anomalySearch
                .value
                .trim()
                .toLowerCase();

        const selectedStatus =
            anomalyStatusFilter
                .value;


        document
            .querySelectorAll(
                "#resultBody tr"
            )
            .forEach(row => {

                const text =
                    row.textContent
                        .toLowerCase();

                const rowStatus =
                    row.dataset.status ??
                    "";


                const keywordMatch =
                    !keyword ||
                    text.includes(keyword);

                const statusMatch =
                    !selectedStatus ||
                    rowStatus === selectedStatus;


                row.style.display =
                    keywordMatch &&
                    statusMatch
                        ? ""
                        : "none";
            });
    }

    function toggleProblemDetail() 
    {

        const detail =
            document.getElementById(
                "problemDetail"
            );

        const button =
            document.getElementById(
                "toggleProblemButton"
            );


        const isOpened =
            detail.style.display ===
            "block";


        detail.style.display =
            isOpened
                ? "none"
                : "block";


        button.textContent =
            isOpened
                ? "查看明細"
                : "收合明細";
    }

</script>

}