@{
    ViewData["Title"] = "標單異常偵測系統";
}

<style>
    .anomaly-page {
        max-width: 98vw;
    }

    .upload-card {
        max-width: 100%;
    }

    .result-table-wrapper {
        width: 100%;
        max-height: 650px;
        overflow-y: auto;
        overflow-x: hidden;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
    }

    #resultTable {
        width: 100%;
        table-layout: fixed;
        margin-bottom: 0;
        font-size: 12px;
    }

        #resultTable th,
        #resultTable td {
            vertical-align: middle;
            padding: 6px 5px;
        }

        #resultTable th {
            text-align: center;
            white-space: normal;
            line-height: 1.3;
        }

        #resultTable thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #212529;
            color: #fff;
        }

    .col-status {
        width: 5%;
    }

    .col-sheet {
        width: 5%;
    }

    .col-row {
        width: 4%;
    }

    .col-code {
        width: 5%;
    }

    .col-category {
        width: 11%;
    }

    .col-name {
        width: 14%;
    }

    .col-spec {
        width: 14%;
    }

    .col-unit {
        width: 4%;
    }

    .col-number {
        width: 7%;
    }

    .col-z {
        width: 6%;
    }

    .col-reason {
        width: 11%;
    }

    .text-wrap-cell {
        white-space: normal !important;
        word-break: break-word;
        line-height: 1.4;
    }

    .text-nowrap-cell {
        white-space: nowrap;
    }

    .summary-box {
        line-height: 1.8;
    }

    .status-badge {
        display: inline-block;
        padding: 3px 6px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
    }

    .status-normal {
        color: #0f5132;
        background-color: #d1e7dd;
    }

    .status-abnormal {
        color: #842029;
        background-color: #f8d7da;
    }

    @@media (max-width: 1200px) {
        #resultTable {
            font-size: 11px;
        }

            #resultTable th,
            #resultTable td {
                padding: 5px 4px;
            }

        .status-badge {
            font-size: 11px;
            padding: 2px 5px;
        }
    }
</style>

<div class="container-fluid mt-4 anomaly-page">
    <h2>標單異常偵測</h2>

    <p class="text-muted">
        上傳 Excel 標單後，系統會直接檢測本次 Excel 內的資料，不會顯示歷史資料，也不會把本次標單存進資料庫。
    </p>

    <div class="card mb-4 upload-card">
        <div class="card-body">
            <label for="excelFile" class="form-label fw-bold">選擇要檢測的 Excel 檔案</label>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <input type="file" id="excelFile" class="form-control" accept=".xlsx" style="max-width: 520px;" />
                <button id="btnAnalyze" class="btn btn-primary">異常偵測</button>
                <span id="loadingText" class="text-muted" style="display:none;">正在讀取與分析 Excel...</span>
            </div>
        </div>
    </div>

    <div id="summaryBox" class="alert alert-info summary-box" style="display:none;"></div>

    <div id="tableWrapper" class="result-table-wrapper" style="display:none;">
        <table class="table table-bordered table-hover align-middle" id="resultTable">
            <thead class="table-dark text-center">
                <tr>
                    <th class="col-status">狀態</th>
                    <th class="col-sheet">工作表</th>
                    <th class="col-row">列號</th>
                    <th class="col-code">項次</th>
                    <th class="col-category">分類</th>
                    <th class="col-name">項目名稱</th>
                    <th class="col-spec">規格</th>
                    <th class="col-unit">單位</th>
                    <th class="col-number">數量</th>
                    <th class="col-number">單價</th>
                    <th class="col-number">複價</th>
                    <th class="col-z">數量 Z</th>
                    <th class="col-z">單價 Z</th>
                    <th class="col-reason">異常原因</th>
                </tr>
            </thead>

            <tbody id="resultBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const btnAnalyze = document.getElementById('btnAnalyze');
        const excelFile = document.getElementById('excelFile');
        const loadingText = document.getElementById('loadingText');
        const summaryBox = document.getElementById('summaryBox');
        const tableWrapper = document.getElementById('tableWrapper');
        const resultBody = document.getElementById('resultBody');

        btnAnalyze.addEventListener('click', async function () {
            if (!excelFile.files || excelFile.files.length === 0) {
                alert('請先選擇 Excel 檔案');
                return;
            }

            const file = excelFile.files[0];
            const formData = new FormData();
            formData.append('excelFile', file);

            loadingText.style.display = 'inline';
            btnAnalyze.disabled = true;
            summaryBox.style.display = 'none';
            tableWrapper.style.display = 'none';
            resultBody.innerHTML = '';

            try {
                const response = await fetch('/api/Estimation/analyze-excel', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (!response.ok) {
                    alert(data.message || 'Excel 分析失敗');
                    return;
                }

                summaryBox.style.display = 'block';
                summaryBox.innerHTML = `
                            檔案：<strong>${escapeHtml(file.name)}</strong><br>
                            共讀取 <strong>${data.totalCount}</strong> 筆資料，
                            發現 <strong class="text-danger">${data.abnormalCount}</strong> 筆異常資料。<br>
                            <span class="text-muted">排序方式：異常項目優先，並依最大 Z 分數由大到小排列。</span>
                        `;

                const sortedResults = data.results.slice().sort((a, b) => {
                    // 先比是否異常：異常排前面
                    if (a.isAbnormal !== b.isAbnormal) {
                        return a.isAbnormal ? -1 : 1;
                    }

                    // 再比最大 Z 分數：由大到小
                    const aMaxZ = getMaxZScore(a);
                    const bMaxZ = getMaxZScore(b);

                    return bMaxZ - aMaxZ;
                });

                sortedResults.forEach(item => {
                    const rowClass = item.isAbnormal ? 'table-danger' : '';
                    const statusText = item.isAbnormal ? '異常' : '正常';
                    const statusBadgeClass = item.isAbnormal ? 'status-abnormal' : 'status-normal';

                    const categoryText = [item.category1, item.category2, item.category3]
                        .filter(x => x && x.trim() !== '')
                        .join(' / ');

                    const tr = document.createElement('tr');
                    tr.className = rowClass;

                    tr.innerHTML = `
                                <td class="text-center">
                                    <span class="status-badge ${statusBadgeClass}">${statusText}</span>
                                </td>

                                <td class="text-center text-nowrap-cell">${escapeHtml(item.sheetName)}</td>
                                <td class="text-end text-nowrap-cell">${item.rowNumber ?? ''}</td>
                                <td class="text-nowrap-cell">${escapeHtml(item.itemCode)}</td>

                                <td class="text-wrap-cell">${escapeHtml(categoryText)}</td>
                                <td class="text-wrap-cell">${escapeHtml(item.itemName)}</td>
                                <td class="text-wrap-cell">${escapeHtml(item.spec)}</td>

                                <td class="text-center text-nowrap-cell">${escapeHtml(item.unit)}</td>
                                <td class="text-end text-nowrap-cell">${formatNumber(item.qty)}</td>
                                <td class="text-end text-nowrap-cell">${formatNumber(item.unitPrice)}</td>
                                <td class="text-end text-nowrap-cell">${formatNumber(item.amount)}</td>
                                <td class="text-end text-nowrap-cell">${formatNumber(item.qtyZScore)}</td>
                                <td class="text-end text-nowrap-cell">${formatNumber(item.unitPriceZScore)}</td>

                                <td class="text-wrap-cell">${escapeHtml(item.statusMessage)}</td>
                            `;

                    resultBody.appendChild(tr);
                });

                tableWrapper.style.display = 'block';
            }
            catch (error) {
                alert('連線或分析失敗：' + error);
            }
            finally {
                loadingText.style.display = 'none';
                btnAnalyze.disabled = false;
            }
        });

        function getMaxZScore(item) {
            const qtyZ = Number(item.qtyZScore);
            const priceZ = Number(item.unitPriceZScore);

            const safeQtyZ = Number.isNaN(qtyZ) ? 0 : qtyZ;
            const safePriceZ = Number.isNaN(priceZ) ? 0 : priceZ;

            return Math.max(safeQtyZ, safePriceZ);
        }

        function formatNumber(value) {
            if (value === null || value === undefined || value === '') return '';

            const num = Number(value);

            if (Number.isNaN(num))
                return value;

            return num.toLocaleString();
        }

        function escapeHtml(value) {
            if (value === null || value === undefined)
                return '';

            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }
    </script>
}