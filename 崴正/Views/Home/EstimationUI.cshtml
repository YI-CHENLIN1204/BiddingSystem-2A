@{
    ViewData["Title"] = "標單異常偵測系統";
}

<div class="container mt-4">
    <h2>標單異常偵測</h2>
    <p class="text-muted">
        上傳 Excel 標單後，系統會顯示所有資料；其中只有「磁磚、混凝土、鋼筋」會拿資料庫歷史資料計算平均值、標準差與 Z 分數，本次上傳的標單不會寫入資料庫。
    </p>

    <div class="card mb-4">
        <div class="card-body">
            <label for="excelFile" class="form-label fw-bold">選擇要檢測的 Excel 檔案</label>
            <input type="file" id="excelFile" class="form-control mb-3" accept=".xlsx" />
            <button id="btnAnalyze" class="btn btn-primary">異常偵測</button>
            <span id="loadingText" class="ms-3 text-muted" style="display:none;">正在讀取 Excel 並比對歷史資料...</span>
        </div>
    </div>

    <div id="summaryBox" class="alert alert-info" style="display:none;"></div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle" id="resultTable" style="display:none; font-size: 14px;">
            <thead class="table-dark text-center">
                <tr>
                    <th>狀態</th>
                    <th>工作表</th>
                    <th>列號</th>
                    <th>項次</th>
                    <th>分類</th>
                    <th>項目名稱</th>
                    <th>檢測材料</th>
                    <th>規格</th>
                    <th>單位</th>
                    <th>數量</th>
                    <th>歷史平均數量</th>
                    <th>歷史數量SD</th>
                    <th>數量 Z</th>
                    <th>單價</th>
                    <th>歷史平均單價</th>
                    <th>歷史單價SD</th>
                    <th>單價 Z</th>
                    <th>複價</th>
                    <th>異常原因</th>
                </tr>
            </thead>
            <tbody id="resultBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const btnAnalyze = document.getElementById('btnAnalyze');
        const excelFile = document.getElementById('excelFile');
        const loadingText = document.getElementById('loadingText');
        const summaryBox = document.getElementById('summaryBox');
        const resultTable = document.getElementById('resultTable');
        const resultBody = document.getElementById('resultBody');

        btnAnalyze.addEventListener('click', async function () {
            if (!excelFile.files || excelFile.files.length === 0) {
                alert('請先選擇 Excel 檔案');
                return;
            }

            const file = excelFile.files[0];
            const formData = new FormData();
            formData.append('excelFile', file);

            loadingText.style.display = 'inline';
            btnAnalyze.disabled = true;
            summaryBox.style.display = 'none';
            resultTable.style.display = 'none';
            resultBody.innerHTML = '';

            try {
                const response = await fetch('/api/Estimation/analyze-excel', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (!response.ok) {
                    alert(data.message || 'Excel 分析失敗');
                    return;
                }

                summaryBox.style.display = 'block';
                summaryBox.innerHTML = `
                    檔案：<strong>${escapeHtml(file.name)}</strong><br>
                    共讀取 <strong>${data.totalCount}</strong> 筆資料，
                    其中 <strong>${data.targetCount ?? 0}</strong> 筆屬於磁磚／混凝土／鋼筋，
                    發現 <strong class="text-danger">${data.abnormalCount}</strong> 筆異常資料。
                `;

                data.results.forEach(item => {
                    const rowClass = item.isAbnormal ? 'table-danger' : '';
                    const statusText = item.isAbnormal ? '異常' : '正常';
                    const statusClass = item.isAbnormal ? 'text-danger fw-bold' : 'text-success';
                    const categoryText = [item.category1, item.category2, item.category3]
                        .filter(x => x && x.trim() !== '')
                        .join(' / ');

                    const tr = document.createElement('tr');
                    tr.className = rowClass;
                    tr.innerHTML = `
                        <td class="text-center ${statusClass}">${statusText}</td>
                        <td>${escapeHtml(item.sheetName)}</td>
                        <td class="text-end">${item.rowNumber}</td>
                        <td>${escapeHtml(item.itemCode)}</td>
                        <td>${escapeHtml(categoryText)}</td>
                        <td>${escapeHtml(item.itemName)}</td>
                        <td>${escapeHtml(item.matchedMaterialName || '-')}</td>
                        <td>${escapeHtml(item.spec)}</td>
                        <td class="text-center">${escapeHtml(item.unit)}</td>
                        <td class="text-end">${formatNumber(item.qty)}</td>
                        <td class="text-end">${formatNumber(item.historicalAvgQty)}</td>
                        <td class="text-end">${formatNumber(item.historicalStdQty)}</td>
                        <td class="text-end">${formatNumber(item.qtyZScore)}</td>
                        <td class="text-end">${formatNumber(item.unitPrice)}</td>
                        <td class="text-end">${formatNumber(item.historicalAvgUnitPrice)}</td>
                        <td class="text-end">${formatNumber(item.historicalStdUnitPrice)}</td>
                        <td class="text-end">${formatNumber(item.unitPriceZScore)}</td>
                        <td class="text-end">${formatNumber(item.amount)}</td>
                        <td>${escapeHtml(item.statusMessage)}</td>
                    `;
                    resultBody.appendChild(tr);
                });

                resultTable.style.display = 'table';
            }
            catch (error) {
                alert('連線或分析失敗：' + error);
            }
            finally {
                loadingText.style.display = 'none';
                btnAnalyze.disabled = false;
            }
        });

        function formatNumber(value) {
            if (value === null || value === undefined || value === '') return '';
            const num = Number(value);
            if (Number.isNaN(num)) return value;
            return num.toLocaleString(undefined, { maximumFractionDigits: 2 });
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) return '';
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }
    </script>
}
