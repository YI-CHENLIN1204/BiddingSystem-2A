@model 崴正.Models.EstimationPageViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "工程用量估算";

    var materialCategories =
        Model.Materials
            .Select(x =>
                string.IsNullOrWhiteSpace(x.Category)
                    ? "未分類"
                    : x.Category!)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    var materialUnits =
        Model.Materials
            .Where(x =>
                !string.IsNullOrWhiteSpace(x.BaseUnit))
            .Select(x => x.BaseUnit)
            .Distinct()
            .OrderBy(x => x)
            .ToList();
}

<style>
    :root {
        --wz-primary: #321fdb;
        --wz-primary-soft: #f0edff;
        --wz-green: #2eb85c;
        --wz-red: #e55353;
        --wz-orange: #f9b115;
        --wz-bg: #f3f5f7;
        --wz-card: #ffffff;
        --wz-border: #d8dbe0;
        --wz-text: #141d23;
        --wz-muted: #6c757d;
        --wz-dark-table: #5b6065;
    }

    body {
        background: var(--wz-bg);
    }

    .estimate-page {
        max-width: 96vw;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .page-title {
        font-size: 1.55rem;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .page-desc {
        color: var(--wz-muted);
        font-size: 14px;
        margin-bottom: 18px;
    }

    .estimate-card {
        background: white;
        border: 1px solid var(--wz-border);
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(20, 29, 35, .06);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .card-header-wz {
        background: #f8f9fa;
        border-bottom: 1px solid var(--wz-border);
        padding: 13px 17px;
    }

    .card-title-wz {
        margin: 0;
        color: var(--wz-primary);
        font-size: 15px;
        font-weight: 800;
    }

    .card-desc-wz {
        margin-top: 3px;
        color: var(--wz-muted);
        font-size: 12px;
    }

    .card-body-wz {
        padding: 18px;
    }

    .mode-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(250px, 1fr));
        gap: 14px;
    }

    .choice-card {
        border: 2px solid #e0e2e5;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: .15s ease;
        background: #fff;
    }

    .choice-card:hover {
        border-color: #aaa0f4;
    }

    .choice-card.active {
        border-color: var(--wz-primary);
        background: var(--wz-primary-soft);
    }

    .choice-title {
        font-weight: 800;
        margin-bottom: 3px;
    }

    .choice-desc {
        font-size: 12px;
        color: var(--wz-muted);
    }

    .form-label {
        font-size: 13px;
        font-weight: 700;
    }

    .form-control,
    .form-select {
        font-size: 14px;
        border-radius: 6px;
    }

    .manual-panel,
    .historical-panel,
    .specified-material-panel {
        display: none;
    }

    .manual-panel.show,
    .historical-panel.show,
    .specified-material-panel.show {
        display: block;
    }

    .material-selector {
        border: 1px solid var(--wz-border);
        border-radius: 7px;
        max-height: 300px;
        overflow-y: auto;
        background: #fff;
    }

    .material-row {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        border-bottom: 1px solid #eee;
        gap: 10px;
    }

    .material-row:last-child {
        border-bottom: none;
    }

    .material-row:hover {
        background: #f8f9fa;
    }

    .material-category {
        margin-left: auto;
        color: var(--wz-muted);
        font-size: 11px;
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
    }

    .btn-analyze {
        border: none;
        border-radius: 6px;
        background: var(--wz-primary);
        color: white;
        padding: 9px 22px;
        font-weight: 800;
    }

    .btn-analyze:hover {
        color: white;
        filter: brightness(.96);
    }

    .btn-analyze:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .result-table-wrapper {
        overflow-x: auto;
    }

    .result-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
        font-size: 13px;
    }

    .result-table th {
        background: var(--wz-dark-table);
        color: white;
        padding: 11px 8px;
        text-align: center;
        white-space: nowrap;
    }

    .result-table td {
        padding: 10px 8px;
        border-bottom: 1px solid #e5e7eb;
        text-align: center;
        vertical-align: middle;
    }

    .result-table tbody tr:hover {
        background: #fafafa;
    }

    .material-name-cell {
        text-align: left !important;
        font-weight: 800;
    }

    .range-value {
        font-variant-numeric: tabular-nums;
        font-weight: 700;
    }

    .median-value {
        color: var(--wz-primary);
        font-weight: 900;
    }

    .status-ok {
        color: var(--wz-green);
        font-weight: 800;
    }

    .status-insufficient {
        color: var(--wz-orange);
        font-weight: 800;
    }

    .message-panel {
        display: none;
        border-radius: 7px;
        padding: 12px 15px;
        margin-bottom: 15px;
        font-size: 13px;
        font-weight: 700;
    }

    .message-panel.error {
        display: block;
        color: #842029;
        background: #f8d7da;
        border: 1px solid #f5c2c7;
    }

    .message-panel.info {
        display: block;
        color: #055160;
        background: #cff4fc;
        border: 1px solid #b6effb;
    }

    .loading-box {
        display: none;
        text-align: center;
        padding: 30px;
        color: var(--wz-muted);
    }

    .loading-box.show {
        display: block;
    }

    .empty-result {
        text-align: center;
        padding: 30px;
        color: var(--wz-muted);
    }
    .material-preview-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-top: 18px;
        margin-bottom: 10px;
    }

    .material-preview-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--wz-text);
    }

    .material-preview-desc {
        color: var(--wz-muted);
        font-size: 12px;
        margin-top: 3px;
    }

    .material-search-box {
        width: 300px;
        max-width: 100%;
    }

    .material-preview-table-wrapper {
        border: 1px solid var(--wz-border);
        border-radius: 7px;
        overflow: hidden;
    }

    .material-preview-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .material-preview-table thead th {
        background: #f4f5f7;
        color: #343a40;
        padding: 9px 12px;
        text-align: left;
        border-bottom: 1px solid var(--wz-border);
        font-weight: 700;
    }

    .material-preview-table tbody td {
        padding: 9px 12px;
        border-bottom: 1px solid #eceff1;
    }

    .material-preview-table tbody tr:last-child td {
        border-bottom: none;
    }

    .material-preview-table tbody tr:hover {
        background: #fafafa;
    }

    .preview-empty {
        color: var(--wz-muted);
        text-align: center !important;
        padding: 22px !important;
    }

    .material-preview-count {
        margin-top: 8px;
        font-size: 12px;
        color: var(--wz-muted);
    }

    .result-header-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .result-search {
        width: 300px;
        max-width: 100%;
    }
    .specified-filter-area {
        margin-bottom: 10px;
    }

    .specified-search-row {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 180px 160px auto;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    .material-unit-filter {
        width: 100%;
    }

    .selected-only-option {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        font-size: 13px;
        cursor: pointer;
    }

    .material-main {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .material-unit {
        color: var(--wz-muted);
        font-size: 12px;
    }

    .material-list-summary {
        display: flex;
        gap: 18px;
        margin-top: 8px;
        color: var(--wz-muted);
        font-size: 12px;
    }

    @@media (max-width: 800px) {
        .specified-search-row {
            grid-template-columns: 1fr;
        }
    }

    .estimation-filter-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 140px;
        gap: 10px;
        width: 430px;
        max-width: 100%;
    }

    .estimation-filter-row .form-control,
    .estimation-filter-row .form-select {
        width: 100%;
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .estimation-filter-row {
            width: 100%;
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="estimate-page mt-4">

    <h2 class="page-title">
         工程用量估算
    </h2>

    <div class="page-desc">
        輸入目標建案條件，系統將依相似歷史建案與材料歷史用量，
        建立 P15 / P50 / P85 合理用量區間。
    </div>


    <!-- ===================================================== -->
    <!-- 1. Target -->
    <!-- ===================================================== -->

    <div class="estimate-card">

        <div class="card-header-wz">
            <div class="card-title-wz">
                輸入目標建案條件
            </div>

            <div class="card-desc-wz">
                本次資料僅作為估算條件，不會建立新的歷史建案資料。
            </div>
        </div>


        <div class="card-body-wz">

            <!-- 手動輸入 -->
            <div class="manual-panel show"
                 id="manualTargetPanel">

                <div class="row g-3">

                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">
                            建案類型
                        </label>

                        <select id="manualProjectType"
                                class="form-select">
                            <option value="">請選擇</option>
                            <option value="住宅">住宅</option>
                            <option value="廠房">廠房</option>
                        </select>
                    </div>


                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">
                            結構類型
                        </label>

                        <select id="manualStructureType"
                                class="form-select">
                            <option value="">請選擇</option>
                            <option value="RC">RC</option>
                            <option value="SC">SC</option>
                            <option value="SRC">SRC</option>
                        </select>
                    </div>


                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">
                            縣市
                        </label>

                        <select id="manualCity"
                                class="form-select">

                            @await Html.PartialAsync("_CityOptions")

                        </select>
                    </div>


                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">
                            總樓地板面積
                        </label>

                        <div class="input-group">
                            <input id="manualFloorArea"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   placeholder="18000" />

                            <span class="input-group-text">
                                m²
                            </span>
                        </div>
                    </div>


                    <div class="col-lg-1 col-md-4">
                        <label class="form-label">
                            地上樓層
                        </label>

                        <input id="manualFloorCount"
                               type="number"
                               class="form-control"
                               min="1"
                               placeholder="20" />
                    </div>


                    <div class="col-lg-1 col-md-4">
                        <label class="form-label">
                            地下樓層
                        </label>

                        <input id="manualBasementCount"
                               type="number"
                               class="form-control"
                               min="0"
                               placeholder="3" />
                    </div>


                    <div class="col-lg-2 col-md-4">
                        <label class="form-label">
                            建案年月
                        </label>

                        <input id="manualProjectMonth"
                               type="month"
                               class="form-control" />
                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- ===================================================== -->
    <!-- 2. Scope -->
    <!-- ===================================================== -->

    <div class="estimate-card">

        <div class="card-header-wz">

            <div class="card-title-wz">
                2. 選擇估算方式
            </div>

            <div class="card-desc-wz">
                核心材料由參數管理中的設定自動決定；指定材料可自行選擇一項或多項材料。
            </div>

        </div>


        <div class="card-body-wz">

            <div class="mode-grid mb-3">

                <div class="choice-card active"
                     id="scopeCoreCard"
                     onclick="setScopeMode('core')">

                    <div class="choice-title">
                         核心材料快速估算
                    </div>

                    <div class="choice-desc">
                        依建案類型與結構，自動估算目前啟用的核心材料。
                    </div>

                </div>


                <div class="choice-card"
                     id="scopeSpecifiedCard"
                     onclick="setScopeMode('specified')">

                    <div class="choice-title">
                         指定材料估算
                    </div>

                    <div class="choice-desc">
                        從標準材料中自行選擇一項或多項材料。
                    </div>

                </div>

            </div>
            <!-- 核心材料待估清單 -->
            <div id="coreMaterialPanel">

                <div class="material-preview-header">

                    <div>
                        <div class="material-preview-title">
                            待估算材料
                        </div>

                        <div class="material-preview-desc"
                            id="coreMaterialHint">
                            請先選擇建案類型與結構類型
                        </div>
                    </div>


                    <div class="material-search-box">
                        <input type="text"
                            id="coreMaterialSearch"
                            class="form-control"
                            placeholder="搜尋材料、分類或單位" />
                    </div>

                </div>


                <div class="material-preview-table-wrapper">

                    <table class="material-preview-table">

                        <thead>
                            <tr>
                                <th>材料名稱</th>
                                <th>分類</th>
                                <th>單位</th>
                            </tr>
                        </thead>

                        <tbody id="coreMaterialTableBody">

                            <tr>
                                <td colspan="3"
                                    class="preview-empty">
                                    請先選擇建案類型與結構類型
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <div class="material-preview-count">
                    目前共
                    <strong id="coreMaterialCount">0</strong>
                    項材料
                </div>

            </div>


            <div class="specified-material-panel"
                id="specifiedMaterialPanel">
                <div class="specified-filter-area">
                    <div class="specified-search-row">

                        <input id="materialSearch"
                            type="search"
                            class="form-control"
                            placeholder="搜尋材料名稱" />


                        <select id="materialCategoryFilter"
                                class="form-select">

                            <option value="">
                                全部類別
                            </option>

                            @foreach (var category in materialCategories)
                            {
                                <option value="@category">
                                    @category
                                </option>
                            }

                        </select>


                        <select id="materialUnitFilter"
                                class="form-select">

                            <option value="">
                                全部單位
                            </option>

                            @foreach (var unit in materialUnits)
                            {
                                <option value="@unit">
                                    @unit
                                </option>
                            }

                        </select>


                        <label class="selected-only-option">

                            <input type="checkbox"
                                id="selectedOnlyFilter"
                                class="form-check-input" />

                            <span>
                                只看已選材料
                            </span>

                        </label>

                    </div>

                </div>


                <div class="material-selector"
                    id="materialSelector">

                    @foreach (var material in Model.Materials)
                    {
                        var category =
                            string.IsNullOrWhiteSpace(material.Category)
                                ? "未分類"
                                : material.Category;

                        <label class="material-row"
                            data-category="@category"
                            data-unit="@material.BaseUnit"
                            data-search="@($"{material.MaterialName} {category} {material.BaseUnit}".ToLower())">

                            <input type="checkbox"
                                class="form-check-input material-checkbox"
                                value="@material.MaterialId" />

                            <span class="material-main">

                                <strong>
                                    @material.MaterialName
                                </strong>

                                <span class="material-unit">
                                    @material.BaseUnit
                                </span>

                            </span>


                            <span class="material-category">
                                @category
                            </span>

                        </label>
                    }

                </div>


                <div class="material-list-summary">

                    <span>
                        顯示
                        <strong id="visibleMaterialCount">
                            @Model.Materials.Count
                        </strong>
                        項
                    </span>

                    <span>
                        已選擇
                        <strong id="selectedMaterialCount">
                            0
                        </strong>
                        項
                    </span>

                </div>

            </div>

        </div>
    </div>


    <!-- ===================================================== -->
    <!-- 3. Action -->
    <!-- ===================================================== -->

    <div class="estimate-card">

        <div class="card-body-wz">

            <div id="messagePanel"
                 class="message-panel">
            </div>


            <div class="action-bar">

                <button type="button"
                        class="btn btn-outline-secondary"
                        onclick="clearEstimationForm()">

                    清除

                </button>


                <button type="button"
                        class="btn-analyze"
                        id="analyzeButton"
                        onclick="runEstimation()">

                    開始估算

                </button>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- 4. Result -->
    <!-- ===================================================== -->

    <div class="estimate-card"
         id="resultCard"
         style="display:none;">

        <div class="card-header-wz">

            <div class="result-header-actions">

                <div>

                    <div class="card-title-wz">
                        3. 合理用量估算結果
                    </div>

                    <div class="card-desc-wz">
                        P15～P85 為目前模型建立的合理用量區間，
                        P50 為加權分布中位數。
                    </div>

                </div>


                <div class="estimation-filter-row">

                    <input type="search"
                        id="estimationResultSearch"
                        class="form-control"
                        placeholder="搜尋材料名稱" />

                    <select id="estimationStatusFilter"
                            class="form-select">

                        <option value="">
                            全部狀態
                        </option>

                        <option value="enough">
                            可估算
                        </option>

                        <option value="insufficient">
                            樣本不足
                        </option>

                    </select>

                </div>

            </div>

        </div>


        <div class="card-body-wz">

            <div class="loading-box"
                 id="loadingBox">
                正在分析相似建案與材料歷史資料...
            </div>


            <div id="resultContent">
                <div class="result-table-wrapper">

                    <table class="result-table">

                        <thead>
                            <tr>
                                <th>材料</th>
                                <th>有效參考建案</th>
                                <th>P15 下界</th>
                                <th>P50 中位</th>
                                <th>P85 上界</th>
                                <th>單位</th>
                                <th>樣本狀態</th>
                            </tr>
                        </thead>

                        <tbody id="resultTableBody">
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

<script>

    let scopeMode =
        "core";

    const coreMaterials =
        @Html.Raw(
            JsonSerializer.Serialize(
                Model.CoreMaterials
            )
        );

    // =====================================================
    // Scope 模式
    // =====================================================

    function setScopeMode(mode) {

        scopeMode = mode;


        document
            .getElementById("scopeCoreCard")
            .classList.toggle(
                "active",
                mode === "core"
            );


        document
            .getElementById("scopeSpecifiedCard")
            .classList.toggle(
                "active",
                mode === "specified"
            );


        document
            .getElementById("coreMaterialPanel")
            .style.display =
                mode === "core"
                    ? ""
                    : "none";


        document
            .getElementById("specifiedMaterialPanel")
            .classList.toggle(
                "show",
                mode === "specified"
            );


        if (mode === "core") {
            renderCoreMaterials();
        }
    }

    function renderCoreMaterials() {



        const projectType =
            document
                .getElementById("manualProjectType")
                .value;

        const structureType =
            document
                .getElementById("manualStructureType")
                .value;

        const keyword =
            document
                .getElementById("coreMaterialSearch")
                .value
                .trim()
                .toLowerCase();


        const tbody =
            document.getElementById(
                "coreMaterialTableBody"
            );


        const hint =
            document.getElementById(
                "coreMaterialHint"
            );


        const count =
            document.getElementById(
                "coreMaterialCount"
            );


        tbody.innerHTML =
            "";


        if (
            !projectType ||
            !structureType
        ) {

            hint.textContent =
                "請先選擇建案類型與結構類型";

            count.textContent =
                "0";


            tbody.innerHTML = `
                <tr>
                    <td colspan="3"
                        class="preview-empty">
                        請先選擇建案類型與結構類型
                    </td>
                </tr>
            `;

            return;
        }


        // ==========================================
        // 找出符合建案情境的核心材料
        //
        // 空白 ProjectType / StructureType
        // 視為通用設定
        // ==========================================

        const matched =
            coreMaterials.filter(x => {

                const projectMatched =
                    !x.ProjectType ||
                    x.ProjectType === projectType;

                const structureMatched =
                    !x.StructureType ||
                    x.StructureType === structureType;


                return (
                    projectMatched &&
                    structureMatched
                );
            });


        // ==========================================
        // 同一 MaterialId 去重
        // ==========================================

        const uniqueMap =
            new Map();


        matched.forEach(x => {

            if (
                !uniqueMap.has(
                    x.MaterialId
                )
            ) {
                uniqueMap.set(
                    x.MaterialId,
                    x
                );
            }

        });


        let materials =
            Array.from(
                uniqueMap.values()
            );


        // ==========================================
        // 搜尋
        // ==========================================

        if (keyword) {

            materials =
                materials.filter(x => {

                    const text =
                        [
                            x.MaterialName,
                            x.Category,
                            x.BaseUnit
                        ]
                        .filter(Boolean)
                        .join(" ")
                        .toLowerCase();


                    return text.includes(
                        keyword
                    );
                });

        }


        materials.sort(
            (a, b) =>
                String(
                    a.Category ?? ""
                )
                .localeCompare(
                    String(
                        b.Category ?? ""
                    ),
                    "zh-TW"
                )
                ||
                String(
                    a.MaterialName ?? ""
                )
                .localeCompare(
                    String(
                        b.MaterialName ?? ""
                    ),
                    "zh-TW"
                )
        );


        hint.textContent =
            `${projectType} / ${structureType} 的核心估算材料`;


        count.textContent =
            materials.length;


        if (materials.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="3"
                        class="preview-empty">
                        目前沒有符合條件的核心估算材料
                    </td>
                </tr>
            `;

            return;
        }


        materials.forEach(
            material => {

                const tr =
                    document.createElement(
                        "tr"
                    );


                tr.innerHTML = `

                    <td>
                        ${escapeHtml(
                            material.MaterialName ?? ""
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            material.Category ?? "未分類"
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            material.BaseUnit ?? ""
                        )}
                    </td>
                `;


                tbody.appendChild(
                    tr
                );

            }
        );
    }

    document
        .getElementById("manualProjectType")
        .addEventListener(
            "change",
            renderCoreMaterials
        );

    document
        .getElementById("manualStructureType")
        .addEventListener(
            "change",
            renderCoreMaterials
        );

    document
        .getElementById("coreMaterialSearch")
        .addEventListener(
            "input",
            renderCoreMaterials
        );


    // =====================================================
    // 建 Target JSON
    // =====================================================

    function buildTarget() {

        const projectType =
            document
                .getElementById("manualProjectType")
                .value;

        const structureType =
            document
                .getElementById("manualStructureType")
                .value;

        const city =
            document
                .getElementById("manualCity")
                .value;

        const floorArea =
            Number(
                document
                    .getElementById("manualFloorArea")
                    .value
            );

        const floorCount =
            Number(
                document
                    .getElementById("manualFloorCount")
                    .value
            );

        const basementFloorCount =
            Number(
                document
                    .getElementById("manualBasementCount")
                    .value
            );

        const projectMonth =
            document
                .getElementById("manualProjectMonth")
                .value;


        if (!projectType) {
            throw new Error("請選擇建案類型");
        }

        if (!structureType) {
            throw new Error("請選擇結構類型");
        }

        if (!city) {
            throw new Error("請選擇縣市");
        }

        if (!floorArea || floorArea <= 0) {
            throw new Error("請輸入有效的總樓地板面積");
        }

        if (!floorCount || floorCount <= 0) {
            throw new Error("請輸入有效的地上樓層數");
        }

        if (basementFloorCount < 0) {
            throw new Error("地下樓層不可小於 0");
        }

        if (!projectMonth) {
            throw new Error("請選擇建案年月");
        }


        return {
            targetMode: 1,
            projectType: projectType,
            structureType: structureType,
            city: city,
            totalFloorArea: floorArea,
            floorCount: floorCount,
            basementFloorCount: basementFloorCount,
            projectMonth: projectMonth
        };
    }


    // =====================================================
    // 執行估算
    // =====================================================

    async function runEstimation() {

        hideMessage();


        const button =
            document.getElementById(
                "analyzeButton"
            );


        try {

            const target =
                buildTarget();


            let url;
            let requestBody;


            if (scopeMode === "core") {

                url =
                    "/api/range-estimation/core";

                requestBody =
                    target;

            }
            else {

                const materialIds =
                    Array
                        .from(
                            document.querySelectorAll(
                                ".material-checkbox:checked"
                            )
                        )
                        .map(x =>
                            Number(x.value)
                        );


                if (materialIds.length === 0) {

                    throw new Error(
                        "請至少選擇一項材料"
                    );

                }


                url =
                    "/api/range-estimation/batch";

                requestBody = {
                    target: target,
                    materialIds: materialIds
                };
            }


            button.disabled =
                true;

            button.textContent =
                "分析中...";


            document
                .getElementById("resultCard")
                .style.display =
                    "block";


            document
                .getElementById("loadingBox")
                .classList.add("show");


            document
                .getElementById("resultContent")
                .style.display =
                    "none";


            const response =
                await fetch(
                    url,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(
                                requestBody
                            )
                    }
                );


            let data = null;


            try {

                data =
                    await response.json();

            }
            catch {
            }


            if (!response.ok) {

                throw new Error(
                    data?.message ??
                    `估算失敗（HTTP ${response.status}）`
                );

            }

            printSimilarityRanking(data);
            renderResult(data);
            

        }
        catch (error) {

            showMessage(
                error.message ??
                "估算失敗",
                "error"
            );


            document
                .getElementById("resultCard")
                .style.display =
                    "none";

        }
        finally {

            button.disabled =
                false;

            button.textContent =
                "開始估算";


            document
                .getElementById("loadingBox")
                .classList.remove("show");

        }

    }


    // =====================================================
    // 結果
    // =====================================================

    function renderResult(data) {

        const results =
            data?.results ?? [];


        const tbody =
            document.getElementById(
                "resultTableBody"
            );


        tbody.innerHTML =
            "";


        if (results.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="7"
                        class="empty-result">
                        本次沒有可顯示的估算結果
                    </td>
                </tr>
            `;

        }
        else {

            results.forEach(item => {

                const row =
                    document.createElement(
                        "tr"
                    );

                row.dataset.status =
                    item.hasEnoughSamples
                        ? "enough"
                        : "insufficient";


                const lower =
                    formatQuantity(
                        item.lowerQuantity
                    );

                const median =
                    formatQuantity(
                        item.medianQuantity
                    );

                const upper =
                    formatQuantity(
                        item.upperQuantity
                    );


                const statusHtml =
                    item.hasEnoughSamples
                        ? `
                            <span class="status-ok">
                                可估算
                            </span>
                          `
                        : `
                            <span class="status-insufficient">
                                ${escapeHtml(
                                    item.statusMessage ??
                                    "樣本不足"
                                )}
                            </span>
                          `;


                row.innerHTML = `

                    <td class="material-name-cell">
                        ${escapeHtml(
                            item.materialName ?? ""
                        )}
                    </td>

                    <td>
                        ${item.referenceProjectCount ?? 0}
                        /
                        ${item.minimumSampleCount ?? "-"}
                        案
                    </td>

                    <td class="range-value">
                        ${lower}
                    </td>

                    <td class="median-value">
                        ${median}
                    </td>

                    <td class="range-value">
                        ${upper}
                    </td>

                    <td>
                        ${escapeHtml(
                            item.baseUnit ?? ""
                        )}
                    </td>

                    <td>
                        ${statusHtml}
                    </td>
                `;


                tbody.appendChild(
                    row
                );

            });

        }


        document
            .getElementById("resultContent")
            .style.display =
                "block";


        document
            .getElementById("resultCard")
            .scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

    }


    function formatQuantity(value) {

        if (
            value === null ||
            value === undefined
        ) {
            return "—";
        }


        return Number(value)
            .toLocaleString(
                "zh-TW",
                {
                    maximumFractionDigits: 2
                }
            );
    }


    // =====================================================
    // Material Search
    // =====================================================

    const materialSearch =
        document.getElementById(
            "materialSearch"
        );

    const materialUnitFilter =
        document.getElementById(
            "materialUnitFilter"
        );

    const selectedOnlyFilter =
        document.getElementById(
            "selectedOnlyFilter"
        );

    const materialCategoryFilter =
        document.getElementById(
            "materialCategoryFilter"
        );


    function filterSpecifiedMaterials() {

        const keyword =
            materialSearch
                .value
                .trim()
                .toLowerCase();

        const selectedCategory =
            materialCategoryFilter
                .value;

        const selectedUnit =
            materialUnitFilter
                .value;

        const selectedOnly =
            selectedOnlyFilter
                .checked;


        let visibleCount =
            0;


        document
            .querySelectorAll(
                "#materialSelector .material-row"
            )
            .forEach(row => {

                const searchText =
                    (
                        row.dataset.search ??
                        ""
                    )
                    .toLowerCase();

                const rowCategory =
                    row.dataset.category ??
                    "";

                const rowUnit =
                    row.dataset.unit ??
                    "";

                const checkbox =
                    row.querySelector(
                        ".material-checkbox"
                    );


                const keywordMatch =
                    !keyword ||
                    searchText.includes(
                        keyword
                    );

                const categoryMatch =
                    !selectedCategory ||
                    rowCategory === selectedCategory;

                const unitMatch =
                    !selectedUnit ||
                    rowUnit === selectedUnit;

                const selectedMatch =
                    !selectedOnly ||
                    checkbox.checked;


                const visible =
                    keywordMatch &&
                    categoryMatch &&
                    unitMatch &&
                    selectedMatch;


                row.style.display =
                    visible
                        ? ""
                        : "none";


                if (visible) {
                    visibleCount++;
                }

            });


        document
            .getElementById(
                "visibleMaterialCount"
            )
            .textContent =
                visibleCount;
    }

    materialCategoryFilter.addEventListener(
        "change",
        filterSpecifiedMaterials
    );

    materialUnitFilter.addEventListener(
        "change",
        filterSpecifiedMaterials
    );

    materialSearch.addEventListener(
        "input",
        filterSpecifiedMaterials
    );

    selectedOnlyFilter.addEventListener(
        "change",
        filterSpecifiedMaterials
    );


    document
        .querySelectorAll(
            ".material-checkbox"
        )
        .forEach(box => {

            box.addEventListener(
                "change",
                function () {

                    updateMaterialCount();

                    if (
                        selectedOnlyFilter.checked
                    ) {
                        filterSpecifiedMaterials();
                    }

                }
            );

        });


    function updateMaterialCount() {

        const count =
            document.querySelectorAll(
                ".material-checkbox:checked"
            ).length;


        document
            .getElementById(
                "selectedMaterialCount"
            )
            .textContent =
                count;

    }


    // =====================================================
    // Messages
    // =====================================================

    function showMessage(
        message,
        type
    ) {

        const panel =
            document.getElementById(
                "messagePanel"
            );


        panel.className =
            `message-panel ${type}`;

        panel.textContent =
            message;

    }


    function hideMessage() {

        const panel =
            document.getElementById(
                "messagePanel"
            );


        panel.className =
            "message-panel";

        panel.textContent =
            "";

    }


    // =====================================================
    // Clear
    // =====================================================

    function clearEstimationForm() {

        document
            .querySelectorAll(
                "#manualTargetPanel input"
            )
            .forEach(x =>
                x.value = ""
            );


        document
            .querySelectorAll(
                "#manualTargetPanel select"
            )
            .forEach(x =>
                x.value = ""
            );


        document
            .querySelectorAll(
                ".material-checkbox"
            )
            .forEach(x =>
                x.checked = false
            );


        document
            .getElementById(
                "materialSearch"
            )
            .value =
                "";


        document
            .querySelectorAll(
                ".material-row"
            )
            .forEach(x =>
                x.style.display = ""
            );


        updateMaterialCount();

        hideMessage();


        document
            .getElementById(
                "resultCard"
            )
            .style.display =
                "none";

    }


    // =====================================================
    // HTML escape
    // =====================================================

    function escapeHtml(value) 
    {

        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    }

    document
        .getElementById("estimationResultSearch")
        .addEventListener(
            "input",
            function () {

                const keyword =
                    this.value
                        .trim()
                        .toLowerCase();


                document
                    .querySelectorAll(
                        "#resultTableBody tr"
                    )
                    .forEach(row => {

                        const text =
                            row.textContent
                                .toLowerCase();


                        row.style.display =
                            !keyword ||
                            text.includes(keyword)
                                ? ""
                                : "none";

                    });

            }
        );
    
    const estimationResultSearch =
        document.getElementById(
            "estimationResultSearch"
        );

    const estimationStatusFilter =
        document.getElementById(
            "estimationStatusFilter"
        );

    function filterEstimationResults() {

        const keyword =
            estimationResultSearch
                .value
                .trim()
                .toLowerCase();

        const selectedStatus =
            estimationStatusFilter
                .value;


        document
            .querySelectorAll(
                "#resultTableBody tr"
            )
            .forEach(row => {

                const text =
                    row.textContent
                        .toLowerCase();

                const rowStatus =
                    row.dataset.status ??
                    "";


                const keywordMatch =
                    !keyword ||
                    text.includes(keyword);

                const statusMatch =
                    !selectedStatus ||
                    rowStatus === selectedStatus;


                row.style.display =
                    keywordMatch &&
                    statusMatch
                        ? ""
                        : "none";
            });
    }

    estimationResultSearch.addEventListener(
        "input",
        filterEstimationResults
    );

    estimationStatusFilter.addEventListener(
        "change",
        filterEstimationResults
    );

    function printSimilarityRanking(data) {

        const ranking =
            data.similarityRanking ?? [];


        console.clear();

        console.log(
            "建案相似度排序"
        );


        if (ranking.length === 0) {

            console.log(
                "目前沒有符合條件的歷史建案"
            );

            return;
        }


        console.table(
            ranking.map(
                (item, index) => ({
                    排名:
                        index + 1,

                    建案名稱:
                        item.projectName ?? "",

                    建案類型:
                        item.projectType ?? "",

                    結構類型:
                        item.structureType ?? "",

                    縣市:
                        item.city ?? "",

                    總樓地板面積:
                        item.totalFloorArea ?? "",

                    地上樓層:
                        item.floorCount ?? "",

                    地下樓層:
                        item.basementFloorCount ?? "",

                    建案年份:
                        item.projectYear ?? "",

                    相似度:
                        `${item.similarityScore ?? 0}`
                })
            )
        );
    }

</script>

}