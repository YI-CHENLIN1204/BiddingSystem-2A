@{
    ViewData["Title"] = "決標單歷史回寫系統";
}

<style>
    :root {
        --wz-primary: #321fdb;
        --wz-primary-soft: #ebe8ff;
        --wz-bg: #ebedef;
        --wz-text: #141d23;
        --wz-muted: #6c757d;
        --wz-border: #d8dbe0;
    }

    body {
        background: var(--wz-bg);
        color: var(--wz-text);
    }

    .final-bid-page {
        max-width: 1280px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .final-bid-page * {
        box-sizing: border-box;
    }

    .page-title {
        font-size: 1.55rem;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .page-description {
        color: var(--wz-muted);
        font-size: 14px;
        margin-bottom: 18px;
    }

    .admin-main-card {
        background: #fff;
        border: 1px solid var(--wz-border);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(20, 29, 35, .06);
        overflow: hidden;
    }

    .form-section + .form-section {
        border-top: 1px solid var(--wz-border);
    }

    .form-section-header {
        padding: 12px 16px;
        background: #f8f9fa;
        border-bottom: 1px solid #e3e5e8;
    }

    .form-section-title {
        color: var(--wz-primary);
        font-size: 14px;
        font-weight: 800;
    }

    .form-section-description {
        margin-top: 2px;
        color: var(--wz-muted);
        font-size: 11px;
    }

    .form-section-body {
        padding: 16px;
    }

    .project-form-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .project-name-field {
        grid-column: 1 / -1;
    }

    .wz-field {
        min-width: 0;
    }

    .wz-label {
        display: block;
        color: #3c4b64;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .wz-input,
    .wz-select {
        width: 100%;
        height: 38px;
        border: 1px solid var(--wz-border);
        border-radius: 6px;
        background-color: #fff;
        color: var(--wz-text);
        font-size: 14px;
        line-height: 1.5;
        padding: 6px 12px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .wz-input::placeholder {
        color: #9aa5b1;
    }

    .wz-input:focus,
    .wz-select:focus {
        border-color: var(--wz-primary);
        box-shadow: 0 0 0 .15rem rgba(50, 31, 219, .12);
        outline: 0;
    }

    .file-input-native {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .file-picker {
        width: 100%;
        min-height: 42px;
        border-radius: 6px;
        border: 1px solid var(--wz-border);
        background: #fff;
        display: flex;
        align-items: center;
        overflow: hidden;
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .file-picker:hover {
        border-color: var(--wz-primary);
        box-shadow: 0 2px 8px rgba(50, 31, 219, .08);
    }

    .file-input-native:focus + .file-picker {
        border-color: var(--wz-primary);
        box-shadow: 0 0 0 .15rem rgba(50, 31, 219, .12);
    }

    .file-picker-button {
        align-self: stretch;
        padding: 0 18px;
        background: var(--wz-primary-soft);
        color: var(--wz-primary);
        border-right: 1px solid var(--wz-border);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 13px;
        white-space: nowrap;
    }

    .file-picker-name {
        color: var(--wz-muted);
        padding: 0 14px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
    }

    .file-picker-name.has-file {
        color: var(--wz-text);
        font-weight: 600;
    }

    .upload-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 14px;
    }

    .upload-hint {
        color: var(--wz-muted);
        font-size: 12px;
    }

    .btn-wz-primary {
        background: var(--wz-primary);
        color: #fff;
        border-radius: 6px;
        padding: 9px 20px;
        font-weight: 800;
        border: none;
        font-size: .95rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-wz-primary:hover {
        color: #fff;
        filter: brightness(.96);
    }

    .loading-text {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 6px;
        background: #f8f9fa;
        color: var(--wz-muted);
        font-size: 12px;
        font-weight: 700;
        text-align: center;
    }

    .stat-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 14px;
        text-align: center;
    }

    .stat-num {
        font-size: 2rem;
        font-weight: 900;
    }

    @@media (max-width: 1000px) {
        .project-form-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .project-form-grid {
            grid-template-columns: 1fr;
        }

        .project-name-field {
            grid-column: auto;
        }

        .file-picker {
            flex-direction: column;
            align-items: stretch;
        }

        .file-picker-button {
            min-height: 42px;
            border-right: 0;
            border-bottom: 1px solid var(--wz-border);
        }

        .file-picker-name {
            padding: 12px 16px;
        }

        .upload-footer {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="container final-bid-page mt-4">
    <h2 class="page-title">決標單歷史回寫</h2>
    <div class="page-description">
        將已完成決標的標單匯入歷史資料庫，供後續工程用量估算與標單異常分析使用。
    </div>

    <div class="admin-main-card">

        <div class="form-section">
            <div class="form-section-header">
                <div class="form-section-title">1. 建案基本資料</div>
                <div class="form-section-description">建立本次決標資料所屬的歷史建案條件。</div>
            </div>

            <div class="form-section-body">
                <div class="project-form-grid">
                    <div class="wz-field project-name-field">
                        <label class="wz-label" for="projectName">工程專案名稱</label>
                        <input type="text"
                               id="projectName"
                               class="wz-input"
                               placeholder="例如：住宅新建工程" />
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="projectType">建案類型</label>
                        <select id="projectType" class="wz-select" required>
                            <option value="">請選擇</option>
                            <option value="住宅">住宅</option>
                            <option value="廠房">廠房</option>
                        </select>
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="structureType">結構類型</label>
                        <select id="structureType" class="wz-select" required>
                            <option value="">請選擇</option>
                            <option value="RC">RC</option>
                            <option value="SC">SC</option>
                            <option value="SRC">SRC</option>
                        </select>
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="city">縣市</label>
                        <select id="city" class="wz-select">
                            <partial name="_CityOptions" />
                        </select>
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="totalFloorArea">總樓地板面積</label>
                        <div class="input-group">
                            <input type="number"
                                   id="totalFloorArea"
                                   class="wz-input"
                                   min="0.01"
                                   step="0.01"
                                   placeholder="例如：12580.5" />
                        </div>
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="floorCount">地上樓層</label>
                        <input type="number"
                               id="floorCount"
                               class="wz-input"
                               min="1"
                               placeholder="例如：15" />
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="basementFloorCount">地下樓層</label>
                        <input type="number"
                               id="basementFloorCount"
                               class="wz-input"
                               min="0"
                               value="0"
                               placeholder="例如：2" />
                    </div>

                    <div class="wz-field">
                        <label class="wz-label" for="projectMonth">建案年月</label>
                        <input type="month"
                               id="projectMonth"
                               class="wz-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-header">
                <div class="form-section-title">2. 上傳最終決標標單</div>
                <div class="form-section-description">支援 .xlsx、.xls、.xlsm、.xlsb、.csv 格式；解析完成後寫入歷史資料並進行材料對應。</div>
            </div>

            <div class="form-section-body">
                <input type="file"
                       id="excelFile"
                       class="file-input-native"
                       accept=".xlsx,.xls,.xlsm,.xlsb,.csv" />

                <label for="excelFile" class="file-picker">
                    <span class="file-picker-button">選擇 Excel 檔案</span>
                    <span id="excelFileName" class="file-picker-name">尚未選擇檔案</span>
                </label>

                <div class="upload-footer">
                    <div class="upload-hint">請確認建案基本資料與標單檔案後再執行回寫。</div>
                    <button id="btnUpload" class="btn-wz-primary">解析並回寫歷史資料</button>
                </div>

                <div id="loadingText"
                     class="loading-text"
                     style="display:none;">
                    系統正在解析標單並同步至資料庫，請稍候。
                </div>
            </div>
        </div>

    </div>

    <div id="resultBox" class="mt-4" style="display:none;">
        <div class="alert alert-success shadow-sm" style="background-color: #fff; border-left: 5px solid #321fdb;">
            <h4 class="alert-heading fw-bold mb-2"
                style="color: #321fdb;">
                建案材料對應摘要
            </h4>

            <div class="text-muted small mb-3">
                統計依目前資料庫狀態即時更新
            </div>

            <!-- 第一排：對應狀態 -->
            <div class="row g-2 mb-3">

                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="text-muted fw-bold">
                            總工項
                        </div>

                        <div class="stat-num text-dark"
                            id="resTotal">
                            0
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-box"
                        style="border-color:#198754;
                                background:#f1faf5;">

                        <div class="fw-bold text-success">
                            自動對應
                        </div>

                        <div class="stat-num text-success"
                            id="resAuto">
                            0
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-box"
                        style="border-color:#321fdb;
                                background:#f3f1ff;">

                        <div class="fw-bold"
                            style="color:#321fdb;">
                            手動對應
                        </div>

                        <div class="stat-num"
                            style="color:#321fdb;"
                            id="resManual">
                            0
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-box"
                        style="border-color:#ffc107;
                                background:#fff9e6;">

                        <div class="fw-bold text-warning">
                            待處理
                        </div>

                        <div class="stat-num text-warning"
                            id="resPending">
                            0
                        </div>
                    </div>
                </div>

            </div>


            <!-- 第二排：待處理原因 -->
            <div class="row g-2">

                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="text-muted fw-bold">
                            數量無效
                        </div>

                        <div class="stat-num"
                            id="resInvalidQuantity">
                            0
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="text-muted fw-bold">
                            單價無效
                        </div>

                        <div class="stat-num"
                            id="resInvalidUnitPrice">
                            0
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="text-muted fw-bold">
                            單位不符
                        </div>

                        <div class="stat-num"
                            id="resUnitMismatch">
                            0
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="text-muted fw-bold">
                            已忽略
                        </div>

                        <div class="stat-num"
                            id="resIgnored">
                            0
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div id="mappingPanel" class="mt-4" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="mb-1">標單材料對應</h4>
                    <div class="text-muted small">
                        可查詢尚未對應、自動對應及人工對應的所有工項
                    </div>
                </div>

                <div class="text-muted small">
                    共 <span id="mappingTotalCount">0</span> 筆
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <input type="text"
                            id="mappingSearch"
                            class="form-control"
                            placeholder="搜尋工項名稱、規格、標準材料或建案名稱" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">
                                對應狀態
                            </label>
                            <select id="mappingStatus"
                                    class="form-select">
                                <option value="Pending" selected>未對應</option>
                                <option value="Auto">自動對應</option>
                                <option value="Manual">手動對應</option>
                                <option value="All">全部</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">待處理原因</label>
                            <select id="mappingIssue"
                                    class="form-select">
                                <option value="All">全部</option>
                                <option value="INVALID_QUANTITY">數量無效</option>
                                <option value="INVALID_UNIT_PRICE">單價無效</option>
                                <option value="UNIT_MISMATCH">單位不符</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">
                                材料分類
                            </label>
                            <select id="mappingCategory"
                                    class="form-select">
                                <option value="All">
                                    全部
                                </option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">
                                單位
                            </label>
                            <select id="mappingUnit"
                                    class="form-select">
                                <option value="All">
                                    全部
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div id="mappingList"></div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <button id="btnMappingPrev"
                        class="btn btn-outline-secondary btn-sm">
                    上一頁
                </button>

                <div class="text-muted small">
                    第 <span id="mappingPage">1</span> 頁
                </div>

                <button id="btnMappingNext"
                        class="btn btn-outline-secondary btn-sm">
                    下一頁
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="createMaterialModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    新增標準材料
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="關閉">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        材料名稱
                    </label>

                    <input type="text"
                           id="newMaterialName"
                           class="form-control"
                           placeholder="請輸入標準材料名稱" />

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        材料分類
                    </label>

                    <select id="newMaterialCategory"
                            class="form-select">
                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        標準單位
                    </label>

                    <select id="newMaterialBaseUnit"
                            class="form-select">
                    </select>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    取消
                </button>

                <button type="button"
                        id="btnCreateMaterial"
                        class="btn btn-primary">
                    新增
                </button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="editBidItemModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    修正標單資料
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="關閉">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        工項
                    </label>

                    <div id="editBidItemName"
                         class="form-control-plaintext">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        數量
                    </label>

                    <input type="number"
                           step="any"
                           id="editBidItemQty"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        單價
                    </label>

                    <input type="number"
                           step="any"
                           id="editBidItemUnitPrice"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        單位
                    </label>

                    <select id="editBidItemUnit"
                            class="form-select">
                        <option value="">請選擇單位</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    取消
                </button>

                <button type="button"
                        id="btnSaveBidItem"
                        class="btn btn-primary">
                    儲存修改
                </button>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        const btnUpload = document.getElementById('btnUpload');
        const excelFile = document.getElementById('excelFile');
        const projectName = document.getElementById('projectName');
        const projectType = document.getElementById('projectType');
        const structureType = document.getElementById('structureType');
        const city = document.getElementById('city');
        const floorCount = document.getElementById('floorCount');
        const basementFloorCount = document.getElementById('basementFloorCount');
        const projectMonth =document.getElementById('projectMonth');

        const mappingPanel = document.getElementById('mappingPanel');
        const mappingList = document.getElementById('mappingList');
        const mappingSearch = document.getElementById('mappingSearch');
        const mappingStatus = document.getElementById('mappingStatus');
        const mappingIssue =document.getElementById('mappingIssue');
        const mappingCategory =document.getElementById('mappingCategory');
        const mappingUnit =document.getElementById('mappingUnit');
        const totalFloorArea =document.getElementById('totalFloorArea');
        let currentProjectId = null;
        let currentMappingPage = 1;
        let currentMappingTotal = 0;
        const mappingPageSize = 50;

        let materialOptions = [];
        let creatingMaterialForItemId = null;
        let currentMappingItems = [];
        let editingBidItemId = null;
        const loadingText = document.getElementById('loadingText');
        const resultBox = document.getElementById('resultBox');
        const excelFileName = document.getElementById('excelFileName');

        excelFile.addEventListener('change', function () {
            const selectedFile = excelFile.files && excelFile.files.length > 0
                ? excelFile.files[0]
                : null;

            excelFileName.textContent = selectedFile ? selectedFile.name : '尚未選擇檔案';
            excelFileName.classList.toggle('has-file', Boolean(selectedFile));
        });

        btnUpload.addEventListener('click', async function () {
            if (!projectName.value.trim()) { alert('請輸入工程專案名稱！'); return; }
            if (!projectType.value) { alert('請選擇建案類型！'); return; }
            if (!structureType.value) { alert('請選擇結構類型！'); return; }
            if (!city.value) { alert('請選擇區域/縣市！'); return; }
            if (!floorCount.value || Number(floorCount.value) <= 0) {alert('請輸入正確的地上樓層數！');return;}
            if (basementFloorCount.value === '' ||Number(basementFloorCount.value) < 0) {alert('請輸入正確的地下樓層數！');return;}
            if (!projectMonth.value) {alert('請選擇建案年月！');return;}
            if (!excelFile.files || excelFile.files.length === 0) { alert('請選擇 Excel 檔案！'); return; }
            if (!totalFloorArea.value ||Number(totalFloorArea.value) <= 0) {alert('請輸入正確的總樓地板面積！');return;}
            const formData = new FormData();
            formData.append('excelFile', excelFile.files[0]);
            formData.append('projectName', projectName.value.trim());
            formData.append('projectType', projectType.value);
            formData.append('structureType', structureType.value);
            formData.append('city', city.value);
            formData.append('floorCount', floorCount.value);
            formData.append('basementFloorCount', basementFloorCount.value);
            formData.append('projectMonth',projectMonth.value);
            formData.append('totalFloorArea', totalFloorArea.value);
            btnUpload.disabled = true;
            loadingText.style.display = 'block';
            resultBox.style.display = 'none';

            try {
                const response = await fetch('/api/Estimation/upload-final-bid', {
                    method: 'POST',
                    body: formData
                });

                const text = await response.text();

                let data;
                try {
                    data = text ? JSON.parse(text) : {};
                } catch (e) {
                    alert('系統回傳格式錯誤，可能是權限不足、路徑錯誤或後端錯誤：' + text.substring(0, 200));
                    return;
                }

                if (!response.ok) {
                    alert(data.message ?? '回寫失敗');
                    return;
                }

                currentProjectId = data.projectId;

                await loadMaterialOptions();
                await loadMappingFilterOptions();

                await loadMappingSummary();
                await loadMappingItems();

                resultBox.style.display = 'block';
                
                excelFile.value = ''; // 清空檔案
                excelFileName.textContent = '尚未選擇檔案';
                excelFileName.classList.remove('has-file');
            } catch (error) {
                alert('系統連線錯誤：' + error);
            } finally {
                btnUpload.disabled = false;
                loadingText.style.display = 'none';
            }
        });
    async function loadMaterialOptions() {
        const response =
            await fetch('/api/Estimation/material-options');

        const data =
            await response.json();

        if (!response.ok) {
            alert(data.message ?? '讀取標準材料失敗');
            return;
        }

        materialOptions = data;
    }
    async function loadMappingItems(page = 1) {
        if (!currentProjectId) {
            mappingPanel.style.display = 'none';
            return;
        }

        currentMappingPage = page;

        const search =
            mappingSearch.value.trim();


        const params =
            new URLSearchParams({
                projectId: currentProjectId,
                status: mappingStatus.value,
                issueCode: mappingIssue.value,
                category: mappingCategory.value,
                unit: mappingUnit.value,
                page: currentMappingPage,
                pageSize: mappingPageSize
            });

        if (search) {
            params.append('search', search);
        }

        const response =
            await fetch(
                '/api/Estimation/mapping-items?' +
                params.toString()
            );

        const data =
            await response.json();

        if (!response.ok) {
            alert(data.message ?? '讀取材料對應資料失敗');
            return;
        }

        currentMappingTotal =
            data.totalCount ?? 0;

        document.getElementById('mappingTotalCount')
            .innerText = currentMappingTotal;

        document.getElementById('mappingPage')
            .innerText = currentMappingPage;

        renderMappingItems(data.items ?? []);

        mappingPanel.style.display = 'block';

        document.getElementById('btnMappingPrev')
            .disabled = currentMappingPage <= 1;

        document.getElementById('btnMappingNext')
            .disabled =
                currentMappingPage * mappingPageSize
                >= currentMappingTotal;
    }

    function getMappingBadge(status) {
        if (status === 'Auto') {
            return `
                <span class="badge bg-success">
                    自動對應
                </span>`;
        }

        if (status === 'Manual') {
            return `
                <span class="badge bg-primary">
                    手動對應
                </span>`;
        }

        return `
            <span class="badge bg-warning text-dark">
                未對應
            </span>`;
    }


    function getDataIssueBadges(item) {
        let html = '';

        if (item.invalidQuantity) {
            html += `
                <span class="badge bg-danger ms-1">
                    數量無效
                </span>
            `;
        }

        if (item.invalidUnitPrice) {
            html += `
                <span class="badge bg-danger ms-1">
                    單價無效
                </span>
            `;
        }

        if (item.unitMismatch) {
            html += `
                <span class="badge bg-danger ms-1">
                    單位不符
                </span>
            `;
        }

        return html;
    }

    function escapeHtml(value) {
        if (value === null ||
            value === undefined) {
            return '';
        }

        return String(value)
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function getIssueLabel(code) {
        switch (code) {
            case 'NO_DICTIONARY_MATCH':
                return '找不到字典';

            case 'MATERIAL_NOT_FOUND':
                return '材料主檔不存在';

            case 'UNIT_MISMATCH':
                return '單位不符';

            case 'INVALID_QUANTITY':
                return '數量無效';

            case 'INVALID_UNIT_PRICE':
                return '單價無效';

            default:
                return code || '未知原因';
        }
    }

    function getIssueBadge(issueCode) {
        if (!issueCode) {
            return '';
        }

        return `
            <span class="badge bg-danger ms-1">
                ${escapeHtml(getIssueLabel(issueCode))}
            </span>
        `;
    }

    function getMaterialCategories() {
        const categories =
            materialOptions
                .map(material =>
                    material.category
                        ? material.category.trim()
                        : ''
                )
                .filter(category =>
                    category !== ''
                );

        return [
            ...new Set(categories)
        ].sort((a, b) =>
            a.localeCompare(
                b,
                'zh-Hant'
            )
        );
    }

    function getMaterialUnits() {
        const units =
            materialOptions
                .map(material =>
                    material.baseUnit
                        ? material.baseUnit.trim()
                        : ''
                )
                .filter(unit =>
                    unit !== ''
                );

        return [
            ...new Set(units)
        ].sort((a, b) =>
            a.localeCompare(
                b,
                'zh-Hant'
            )
        );
    }

    function getEditableUnits() {
        const units = [];

        const mappingUnitSelect =
            document.getElementById('mappingUnit');

        if (mappingUnitSelect) {
            Array.from(mappingUnitSelect.options)
                .forEach(option => {
                    const value = option.value?.trim();

                    if (value &&
                        value !== 'All') {
                        units.push(value);
                    }
                });
        }

        materialOptions.forEach(material => {
            const unit =
                material.baseUnit?.trim();

            if (unit) {
                units.push(unit);
            }
        });

        return [
            ...new Set(units)
        ].sort((a, b) =>
            a.localeCompare(
                b,
                'zh-Hant'
            )
        );
    }

