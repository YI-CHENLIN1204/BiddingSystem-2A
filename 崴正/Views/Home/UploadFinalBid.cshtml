            );
        }
    );

    async function ignoreBidItem(finalBidItemId) {
        const item = currentMappingItems.find(x =>
            Number(x.finalBidItemId) === Number(finalBidItemId)
        );

        if (!item) {
            return;
        }

        const confirmed = confirm(
            `確定要忽略「${item.itemName}」嗎？\n\n` +
            `忽略後，此工項不會進入歷史資料庫，也不會出現在預設待處理清單。`
        );

        if (!confirmed) {
            return;
        }

        const formData = new FormData();

        formData.append(
            'finalBidItemId',
            finalBidItemId
        );

        const response = await fetch(
            '/api/Estimation/ignore-bid-item',
            {
                method: 'POST',
                body: formData
            }
        );

        const data = await response.json();

        if (!response.ok) {
            alert(data.message ?? '忽略工項失敗');
            return;
        }

        await loadMappingItems();
        await loadMappingSummary();
    }
    
</script>
}
