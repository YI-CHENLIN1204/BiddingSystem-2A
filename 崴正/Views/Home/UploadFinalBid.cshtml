    async function updateMaterialMapping(finalBidItemId) {
        const select =
            document.getElementById(
                `mappingMaterial_${finalBidItemId}`
            );

        const materialId =
            select.value;

        if (!materialId) {
            alert('請先選擇標準材料');
            return;
        }

        if (!confirm('確定要更新此工項的材料對應嗎？')) {
            return;
        }

        const formData =
            new FormData();

        formData.append(
            'finalBidItemId',
            finalBidItemId
        );

        formData.append(
            'materialId',
            materialId
        );

        const response =
            await fetch(
                '/api/Estimation/update-material-mapping',
                {
                    method: 'POST',
                    body: formData
                }
            );

        const data =
            await response.json();

        if (!response.ok) {
            alert(data.message ?? '材料對應更新失敗');
            return;
        }

        alert(data.message);

        await loadMappingItems(
            currentMappingPage
        );

        await loadMappingSummary();
    }

