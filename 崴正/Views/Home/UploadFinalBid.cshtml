                return;
            }

            const materialName =
                document.getElementById(
                    'newMaterialName'
                ).value.trim();

            const category =
                document.getElementById(
                    'newMaterialCategory'
                ).value;

            const baseUnit =
                document.getElementById(
                    'newMaterialBaseUnit'
                ).value;

            if (!materialName) {
                alert('請輸入標準材料名稱');
                return;
            }

            if (!category) {
                alert('請選擇材料分類');
                return;
            }

            if (!baseUnit) {
                alert('請選擇標準單位');
                return;
            }

            const formData =
                new FormData();

            formData.append(
                'materialName',
                materialName
            );

            formData.append(
                'category',
                category
            );

            formData.append(
                'baseUnit',
                baseUnit
            );

            const response =
                await fetch(
                    '/api/Estimation/create-material',
                    {
                        method: 'POST',
                        body: formData
                    }
                );

            const data =
                await response.json();

            if (!response.ok) {
                alert(
                    data.message ??
                    '新增標準材料失敗'
                );

                return;
            }

            await loadMaterialOptions();

            const categorySelect =
                document.getElementById(
                    `mappingCategory_${creatingMaterialForItemId}`
                );

            const materialSelect =
                document.getElementById(
                    `mappingMaterial_${creatingMaterialForItemId}`
                );

            categorySelect.value =
                data.category;

            materialSelect.innerHTML =
                buildMaterialOptions(
                    data.category,
                    data.materialId
                );

            materialSelect.disabled =
                false;

            materialSelect.value =
                data.materialId;

            changeMaterialSelection(
                creatingMaterialForItemId
            );

            const modalElement =
                document.getElementById(
                    'createMaterialModal'
                );

            bootstrap.Modal
                .getInstance(modalElement)
                ?.hide();

            creatingMaterialForItemId =
                null;
        }
    );

    document.getElementById('btnSaveBidItem').addEventListener(
        'click',
        async function () {
            if (!editingBidItemId) {
                return;
            }

            const qty = document.getElementById('editBidItemQty').value;
            const unitPrice = document.getElementById('editBidItemUnitPrice').value;
            const unit = document.getElementById('editBidItemUnit').value.trim();

            const formData = new FormData();

            formData.append('finalBidItemId', editingBidItemId);
            formData.append('qty', qty);
            formData.append('unitPrice', unitPrice);
            formData.append('unit', unit);

            const response = await fetch(
                '/api/Estimation/update-bid-item-data',
                {
                    method: 'POST',
                    body: formData
                }
            );

            const data = await response.json();

            if (!response.ok) {
                alert(data.message ?? '修正資料失敗');
                return;
            }

            bootstrap.Modal
                .getInstance(
                    document.getElementById('editBidItemModal')
                )
                ?.hide();

