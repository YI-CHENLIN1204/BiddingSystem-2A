    function openEditBidItemModal(finalBidItemId) {
        const item = currentMappingItems.find(x =>
            Number(x.finalBidItemId) === Number(finalBidItemId)
        );

        if (!item) {
            alert('找不到此工項資料');
            return;
        }

        editingBidItemId = finalBidItemId;

        document.getElementById('editBidItemName').textContent =
            item.itemName ?? '';

        document.getElementById('editBidItemQty').value =
            item.qty ?? '';

        document.getElementById('editBidItemUnitPrice').value =
            item.unitPrice ?? '';

        const unitSelect =
            document.getElementById('editBidItemUnit');

        unitSelect.innerHTML =
            '<option value="">請選擇單位</option>';

        const editableUnits =
            getEditableUnits();

        const currentUnit =
            item.unit?.trim() ?? '';

        if (currentUnit &&
            !editableUnits.includes(currentUnit)) {
            editableUnits.push(currentUnit);

            editableUnits.sort((a, b) =>
                a.localeCompare(
                    b,
                    'zh-Hant'
                )
            );
        }

        editableUnits.forEach(unit => {
            const option =
                document.createElement('option');

            option.value = unit;
            option.textContent = unit;

            unitSelect.appendChild(option);
        });

        unitSelect.value =
            currentUnit;

        const modal = bootstrap.Modal.getOrCreateInstance(
            document.getElementById('editBidItemModal')
        );

        modal.show();
    }
    
    async function loadMappingSummary() {
        if (!currentProjectId) {
            return;
        }

        const params =
            new URLSearchParams({
                projectId: currentProjectId
            });

        const response =
            await fetch(
                '/api/Estimation/mapping-summary?' +
                params.toString()
            );

        const data =
            await response.json();

        if (!response.ok) {
            alert(
                data.message ??
                '讀取建案統計失敗'
            );

            return;
        }

        document.getElementById(
            'resTotal'
        ).innerText =
            data.totalCount ?? 0;

        document.getElementById(
            'resAuto'
        ).innerText =
            data.autoCount ?? 0;

        document.getElementById(
            'resManual'
        ).innerText =
            data.manualCount ?? 0;

        document.getElementById(
            'resPending'
        ).innerText =
            data.pendingCount ?? 0;

        document.getElementById(
            'resInvalidQuantity'
        ).innerText =
            data.invalidQuantityCount ?? 0;

        document.getElementById(
            'resInvalidUnitPrice'
        ).innerText =
